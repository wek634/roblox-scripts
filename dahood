    local function stopFeedbackTween(object)
        local entry = feedbackTweens[object]
        if not entry then return end
        feedbackTweens[object] = nil
        if entry.Connection then entry.Connection:Disconnect() end
        entry.Tween:Cancel()
        entry.Tween:Destroy()
    end
    local function cancelFeedbackTweens()
        for object in pairs(feedbackTweens) do stopFeedbackTween(object) end
        feedbackGoals = {}
    end
    local function setFeedbackGoal(object, goals, instant)
        if destroyed or not object.Parent then return end
        local previous = feedbackGoals[object]
        local same = previous ~= nil
        if same then
            for property, value in pairs(goals) do
                if previous[property] ~= value then same = false; break end
            end
            if same then
                for property in pairs(previous) do
                    if goals[property] == nil then same = false; break end
                end
            end
        end
        if same then return end
        stopFeedbackTween(object)
        feedbackGoals[object] = goals
        if instant or not visible then
            for property, value in pairs(goals) do object[property] = value end
            return
        end
        local ok, tween = pcall(TweenService.Create, TweenService, object, feedbackInfo, goals)
        if not ok or not tween then
            for property, value in pairs(goals) do object[property] = value end
            return
        end
        local entry = { Tween = tween }
        feedbackTweens[object] = entry
        entry.Connection = tween.Completed:Connect(function()
            if feedbackTweens[object] == entry then feedbackTweens[object] = nil end
            if entry.Connection then entry.Connection:Disconnect() end
            tween:Destroy()
        end)
        tween:Play()
    end
