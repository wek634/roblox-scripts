        if workspace then camera = workspace.CurrentCamera end
        self:Render(camera)
    end
    syncConfigUI = function() ui:Sync() end
    function ui:SetVisible(value)
        if destroyed then return end
        value = value == true
        if visible == value then return end
        endDrag()
        closeDropdown()

        if value then savedMouseIcon = Input.MouseIconEnabled end
        visible, closeButton.Modal, gui.Enabled = value, value, value
        if value then
            Input.MouseIconEnabled = true
            clampPanel()
            feedbackPending = true
            refreshFeedback(false)
        else
            releaseInputFocus()
            feedbackPending = false
            cancelFeedbackTweens()
            refreshFeedback(true)

            if savedMouseIcon ~= nil and Input.MouseIconEnabled == true then
                Input.MouseIconEnabled = savedMouseIcon
            end
            savedMouseIcon = nil
        end
    end
    function ui:IsVisible() return not destroyed and visible end
    function ui:Render(camera)
        if destroyed then return end
        if dragInput then dragHeld() end
        if feedbackPending and visible then
            feedbackPending = false
            refreshFeedback(false)
        end
        lastCamera = camera
        local display = camera ~= nil and Settings.Enabled == true
            and Settings.ShowFOV == true and Settings.FOVEnabled == true
        if not display then circle.Visible = false; clearBoxes(); return end
        local visuals
        if type(ctx.GetFOVVisuals) == "function" then visuals = ctx.GetFOVVisuals() end
        visuals = visuals or { shape = Settings.FOVShape or "Circle", enabled = true, radius = Settings.FOV, boxes = {} }
        if not visuals.enabled then circle.Visible = false; clearBoxes(); return end
        if visuals.shape ~= "Box" then
            clearBoxes()
            local radius = math.clamp(tonumber(visuals.radius) or 0, 0, 300)
            circle.Size = UDim2.fromOffset(radius * 2, radius * 2)
            circle.Visible = radius > 0
            if circle.Visible then
                local point = ctx.ReferencePoint(camera)
                circle.Position = UDim2.fromOffset(point.X, point.Y)
            end
            return
        end
        circle.Visible = false
        local seen = {}
        for _, entry in ipairs(visuals.boxes or {}) do
            local part, size = entry.part, entry.size
            if part and part.Parent and size and size.X > 0 and size.Y > 0 and size.Z > 0 then
                local adornment = boxAdornments[part]
                if not adornment then
                    adornment = make("BoxHandleAdornment", boxRoot, {
                        Name = "FOVBox", Adornee = part, Size = size, CFrame = CFrame.new(),
                        Color3 = Color3.fromRGB(235, 235, 235), Transparency = 0.91,
                        AlwaysOnTop = false, ZIndex = 0, Visible = true,
                    })
                    boxAdornments[part] = adornment
                end
                adornment.Size, adornment.Visible = size, true
                seen[part] = true
            end
        end
        for part, adornment in pairs(boxAdornments) do
            if not seen[part] then
                adornment.Visible, adornment.Adornee = false, nil
                adornment:Destroy()
                boxAdornments[part] = nil
            end
        end
    end
    function ui:SetStatus(_text)

    end
    function ui:Destroy()
        if destroyed then return end
        self:SetVisible(false)
        cancelFeedbackTweens()
        stopStatusFade()
        destroyed = true
        if configUI.ClearOptions then configUI.ClearOptions() end
        feedbackEntries = {}
        endDrag()
        closeDropdown()
        clearBoxes()
        circle.Visible, closeButton.Modal = false, false
        if not insideGuiDestroy and gui.Parent then gui:Destroy() end
        if overlay.Parent then overlay:Destroy() end
    end

    ui:Sync()
    setTab("Assistance")
    ui:SetVisible(true)
    return ui
end

