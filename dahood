    local statusFadeInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 2.5)
    local statusFadeTween
    local statusMessage, statusRevision = "", -1
    local function stopStatusFade()
        local tween = statusFadeTween
        statusFadeTween = nil
        if tween then tween:Cancel(); tween:Destroy() end
    end
    local function updateConfigStatus(message)
        if message == statusMessage and configStatusRevision == statusRevision then return end
        stopStatusFade()
        statusMessage, statusRevision = message, configStatusRevision
        statusLabel.Text = message
        statusLabel.TextTransparency = message == "" and 1 or 0
        if message == "" or destroyed then return end
        local ok, tween = pcall(TweenService.Create, TweenService, statusLabel, statusFadeInfo, {TextTransparency = 1})
        if ok and tween then
            statusFadeTween = tween
            tween:Play()
        else
            statusLabel.TextTransparency = 1
        end
    end
    configUI.Sync = function()
        if destroyed then return end
        local backend = ctx.Configs
        if type(backend) == "table" and type(backend.GetState) == "function" then
            local ok, state = pcall(backend.GetState, backend)
            if ok and type(state) == "table" then
                configUI.State = {
                    Names = type(state.Names) == "table" and state.Names or {},
                    Selected = type(state.Selected) == "string" and state.Selected or "",
                    Loaded = type(state.Loaded) == "string" and state.Loaded or "",
                    AutoLoad = state.AutoLoad == true, Available = state.Available == true,
                    Busy = state.Busy == true, Status = type(state.Status) == "string" and state.Status or "",
                }
            else
                configUI.State.Available = false
                configUI.Notice = "Config state unavailable"
            end
        end
        local state = configUI.State
        rebuildConfigOptions(state.Names)
        configsLabel.Text = state.Selected ~= "" and state.Selected or "None"
        for _, option in ipairs(configsDropdown.Options) do
            option.Button.BackgroundTransparency = option.Name == state.Selected and 0 or 1
        end
        configNameBox.TextEditable = configReady()
        autoMark.Visible = state.AutoLoad
        autoLabel.Text = state.AutoLoad and state.Loaded ~= "" and ("Auto load: " .. state.Loaded) or "Auto load config"
        local message = configUI.Notice ~= "" and configUI.Notice or state.Status
        if configUI.Notice == "" and state.AutoLoad and state.Loaded ~= ""
            and not string.find(state.Status, "Auto load:", 1, true) then
            message = (state.Status ~= "" and state.Status .. " | " or "") .. "Auto: " .. state.Loaded
        end
        updateConfigStatus(message)
        if not configReady() and activeDropdown == configsDropdown then closeDropdown() end
    end


