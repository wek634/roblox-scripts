local running = true
local closed = false
local closing = false
local connections = {}
local selector, ui, router, visual, movement, hitbox, particles, configs, uiRoot
local state = {Settings = Settings, Version = 25, Errors = {}, UIIsolated = false}
local function isCurrent()
    return running and not closed and env.__DH_GunHandlerAimUI == state
end
local function reportOnce(area, problem)
    if state.Errors[area] == nil then state.Errors[area] = tostring(problem) end
end
local function track(signal, callback)
    local connection = signal:Connect(callback)
    connections[#connections + 1] = connection
    return connection
end

local function cleanup()
    if closed then return true end
    if closing then return false, "Cleanup is already running." end
    closing, running = true, false
    local failures = {}
    local function attempt(callback)
        local ok, problem = pcall(callback)
        if not ok then failures[#failures + 1] = tostring(problem) end
    end

    if hitbox then
        local ok, result = pcall(hitbox.SetRoutingReady, hitbox, false)
        if not ok or result == false then
            local problem = ok and "Hitbox queries could not be disabled" or tostring(result)
            closing = false
            reportOnce("unload", problem)
            return false, problem
        end
    end
    if configs then attempt(function() configs:Destroy() end) end
    if router then attempt(function() router:Destroy() end) end
    if visual then attempt(function() visual:Destroy() end) end
    if movement then attempt(function() movement:Destroy() end) end
    if hitbox then attempt(function()
        if hitbox:Destroy() == false then error("Some hitbox properties could not be restored", 0) end
    end) end
    if particles then attempt(function()
        if particles:Destroy() == false then error("Some particle origins could not be restored", 0) end
    end) end
    for _, connection in ipairs(connections) do
        attempt(function() connection:Disconnect() end)
    end
    connections = {}
    if selector then attempt(function() selector:Destroy() end) end
    if ui then attempt(function() ui:Destroy() end) end
    if uiRoot then attempt(function() uiRoot:Destroy() end) end

    if env.__DH_GunHandlerAimUI == state then
        for _, name in ipairs({"DH_AimPanel", "DH_AimOverlay"}) do
            attempt(function()
                local item = PlayerGui:FindFirstChild(name)
                if item then item:Destroy() end
            end)
        end
    end
    closing = false
    if #failures > 0 then
        local problem = table.concat(failures, " | ")
        reportOnce("unload", problem)
        return false, problem
    end
    closed = true
    if env.__DH_GunHandlerAimUI == state then env.__DH_GunHandlerAimUI = nil end
    return true
end
state.Cleanup = cleanup

local function referencePoint(camera)
    if Settings.AimPoint == "Center" then return camera.ViewportSize * 0.5 end
    if Settings.AimPoint == "Auto" then
        if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
            or _G.MobileShiftLock or _G.MobleAimingIn
            or (UserInputService.TouchEnabled and not UserInputService.MouseEnabled) then
            return camera.ViewportSize * 0.5
        end
    end
    return UserInputService:GetMouseLocation()
end

local function setSetting(key, value)
    if not running then return false, "The script is unloaded." end
    local normalized, problem = normalizeSetting(key, value)
    if problem then return false, problem end
    if Settings[key] ~= normalized then
        Settings[key] = normalized
        local visualOnly = key == "ClientBulletRedirection" or key == "VisualPredictionMs"
            or key == "RedirectShotguns" or key == "RedirectPistols" or key == "RedirectOther"
        local presentationOnly = key == "ShowFOV" or key == "FOVWeaponGroup" or key == "TargetKey"
            or key == "HitboxShow"
        local hitboxSetting = key == "HitboxEnabled" or key == "HitboxTarget"
            or key == "HitboxX" or key == "HitboxY" or key == "HitboxZ" or key == "HitboxShow"
        local movementOnly = key == "MovementEnabled" or key == "WalkMultiplier"
            or key == "ReloadMultiplier" or key == "ShootMultiplier"
            or key == "LowHealthMultiplier" or key == "LowHealthThreshold"
        if selector and not presentationOnly and key ~= "HitChance"
            and key ~= "SpreadPercent" and key ~= "SpreadEnabled"
            and not visualOnly and not movementOnly then
            selector:Invalidate(key ~= "Mode" and key ~= "Enabled")
        end
        if router and key == "Enabled" then router:Invalidate() end
        if visual and (visualOnly or key == "Enabled") then visual:Invalidate() end
        if movement and movementOnly then
            local ok, failure = pcall(movement.Refresh, movement)
            if not ok then
                pcall(movement.Invalidate, movement)
                reportOnce("movement", failure)
            end
        end
        if hitbox and (hitboxSetting or key == "TeamCheck" or key == "SkipKnocked") then
            local ok, failure = pcall(hitbox.Refresh, hitbox)
            if not ok then
                pcall(hitbox.Invalidate, hitbox)
                reportOnce("hitbox", failure)
            end
        end
        if particles and (hitboxSetting or key == "TeamCheck" or key == "SkipKnocked") then
            local ok, failure = pcall(particles.Refresh, particles)
            if not ok then
                pcall(particles.Invalidate, particles)
                reportOnce("particle spoofer", failure)
            end
        end

    end
    if ui then ui:Sync() end
    return true
end
state.SetSetting = setSetting
local function snapshotConfiguration()
    local values = {}
    for key in pairs(DefaultSettings) do values[key] = Settings[key] end
    return values
end
local function refreshConfiguration()
    local failures = {}
    local function invoke(area, object, method, ...)
        if not object then return end
        local ok, result = pcall(object[method], object, ...)
        if not ok or result == false then
            local problem = ok and (area .. " could not be updated") or tostring(result)
            failures[#failures + 1] = problem
            reportOnce("config " .. area, problem)
        end
    end
    invoke("target selection", selector, "Invalidate", false)
    invoke("shot routing", router, "Invalidate")
    invoke("tracers", visual, "Invalidate")
    invoke("movement", movement, "Refresh")
    invoke("hitboxes", hitbox, "Refresh")
    invoke("particles", particles, "Refresh")
    for _, entry in ipairs({{hitbox, "hitboxes"}, {particles, "particles"}}) do
        local object, area = entry[1], entry[2]
        if object then
            local ok, result = pcall(object.GetDiagnostics, object)
            if not ok or type(result) ~= "table"
                or (tonumber(result.pendingRestore) or 0) > 0
                or (tonumber(result.unsafeQueries) or 0) > 0 then
                failures[#failures + 1] = area .. " cleanup is incomplete"
                reportOnce("config " .. area, failures[#failures])
            end
        end
    end
    return #failures == 0, table.concat(failures, " | ")
end
local function applyConfiguration(values)
    if not isCurrent() then return false, "Script unloaded" end
    if type(values) ~= "table" then return false, "Invalid config" end
    local validated = {}
    for key in pairs(DefaultSettings) do
        local value, problem = normalizeSetting(key, values[key])
        if problem then return false, "Invalid config" end
        validated[key] = value
    end
    local previousValues = snapshotConfiguration()
    for key, value in pairs(validated) do Settings[key] = value end
    local called, updated = pcall(refreshConfiguration)
    local ok = called and updated == true
    if not called then reportOnce("config apply", updated) end
    if not isCurrent() then return false, "Script unloaded" end
    if ok and ui then
        local synced, failure = pcall(ui.Sync, ui)
        if not synced then
            reportOnce("config UI", failure)
            ok = false
        end
    end
    if not ok then
        for key, value in pairs(previousValues) do Settings[key] = value end
        local restored, restoreResult = pcall(refreshConfiguration)
        if not restored or restoreResult ~= true then
            reportOnce("config restore", restored and "Controller restore incomplete" or restoreResult)
        end
        if isCurrent() and ui then
            local synced, failure = pcall(ui.Sync, ui)
            if not synced then reportOnce("config UI restore", failure) end
        end
        return false, "Could not apply config"
    end
    return true
end
state.GetDiagnostics = function()
    return selector and selector:GetDiagnostics() or {status = running and "Starting" or "Unloaded"}
end
state.GetMovementDiagnostics = function()
    return movement and movement:GetDiagnostics() or {enabled = false, mode = running and "Starting" or "Unloaded"}
end
state.GetHitboxDiagnostics = function()
    local result = hitbox and hitbox:GetDiagnostics() or {enabled = false, mode = running and "Starting" or "Unloaded"}
    result.particles = particles and particles:GetDiagnostics() or {enabled = false, mode = running and "Starting" or "Unloaded"}
    return result
end
state.ToggleTarget = function()
    if not running or not selector or Settings.Mode ~= "CurrentTarget" then return false end
    return selector:ToggleTarget()
end

