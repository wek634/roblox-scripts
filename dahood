local function normalizeSetting(key, value)
    if Settings[key] == nil then return nil, "Unknown setting: " .. tostring(key) end
    if key == "Target" then
        if value == "Closest" or value == "NearestPart" then value = "ClosestPart" end
        if KNOWN_BODY_PARTS[value] then value = "SelectedParts" end
    elseif key == "TriggerPartMode" then
        if value == "Any" then value = "NearestPart" end
        if value == "Selected" then value = "SelectedParts" end
    elseif key == "HitboxTarget" and value == "Root" then
        value = "NearestPart"
    end
    if key == "MenuKey" then
        if not isMenuBindableKey(value) then return nil, "Invalid key" end
        return value
    end
    if key == "TargetKey" or key == "TriggerKey" or key == "SilentKey" then
        if not isBindableKey(value) then return nil, "Invalid key" end
        return value
    end
    if numericLimits[key] then
        if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
            return nil, key .. " must be a finite number."
        end
        local limits = numericLimits[key]
        value = math.clamp(value, limits[1], limits[2])
        value = limits[1] + math.floor((value - limits[1]) / limits[3] + 0.5) * limits[3]
        return math.clamp(math.floor(value * 10000 + 0.5) / 10000, limits[1], limits[2])
    end
    if choices[key] then
        if not choices[key][value] then return nil, "Invalid option for " .. key end
        return value
    end
    if type(value) ~= "boolean" then return nil, key .. " must be true or false." end
    return value
end
