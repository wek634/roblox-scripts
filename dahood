local AIM_PISTOL_NAMES = {
    ["[Revolver]"] = true, ["[Glock]"] = true, ["[Silencer]"] = true,
    ["[USP]"] = true, ["[Pistol]"] = true, ["[Flintlock]"] = true,
}
local function classifyWeapon(tool)
    local name = tool and tool.Name or ""
    local lower = string.lower(name)
    if string.find(lower, "shotgun", 1, true) or string.find(lower, "double-barrel", 1, true)
        or string.find(lower, "doublebarrel", 1, true) then return "Shotguns" end
    return AIM_PISTOL_NAMES[name] and "Pistols" or "Other"
end

local function getFOVProfile(settings, tool)
    local prefix = settings.PerWeaponFOV and classifyWeapon(tool) or ""
    local function value(suffix, fallback, maximum)
        local number = settings[prefix .. "FOV" .. suffix]
        if type(number) ~= "number" or number ~= number then number = settings["FOV" .. suffix] end
        if type(number) ~= "number" or number ~= number then number = fallback end
        return math.clamp(number, 0, maximum)
    end
    return {
        shape = settings.FOVShape == "Box" and "Box" or "Circle",
        enabled = settings.FOVEnabled ~= false,
        radius = value("", 100, 300),
        x = value("X", 5, 20), y = value("Y", 5, 20), z = value("Z", 5, 20),
    }
end

local function getCharacterFOVRoot(character)
    if not character then return nil end
    for _, name in ipairs({ "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso" }) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then return part end
    end
    return nil
end

local function rayIntersectsBox(ray, frame, size)
    if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then return false end
    local origin = frame:PointToObjectSpace(ray.Origin)
    local direction = frame:VectorToObjectSpace(ray.Direction)
    local half = size * 0.5
    local o, d, h = { origin.X, origin.Y, origin.Z }, { direction.X, direction.Y, direction.Z }, { half.X, half.Y, half.Z }
    local enter, leave = 0, math.huge
    for index = 1, 3 do
        if math.abs(d[index]) <= 0.000000001 then
            if math.abs(o[index]) > h[index] then return false end
        else
            local first = (-h[index] - o[index]) / d[index]
            local last = (h[index] - o[index]) / d[index]
            if first > last then first, last = last, first end
            enter, leave = math.max(enter, first), math.min(leave, last)
            if leave < enter then return false end
        end
    end
    return leave >= enter
end

local function closestRayBoxPoint(frame, size, ray)
    local origin = frame:PointToObjectSpace(ray.Origin)
    local direction = frame:VectorToObjectSpace(ray.Direction)
    local half = size * 0.5
    local o, d, h = { origin.X, origin.Y, origin.Z }, { direction.X, direction.Y, direction.Z }, { half.X, half.Y, half.Z }
    local cuts = { 0 }
    local directionSquared = direction:Dot(direction)
    if directionSquared <= 0.000000000001 then
        return Vector3.new(math.clamp(o[1], -h[1], h[1]), math.clamp(o[2], -h[2], h[2]), math.clamp(o[3], -h[3], h[3]))
    end
    local preferred = math.max(0, -origin:Dot(direction) / directionSquared)
    for index = 1, 3 do
        if math.abs(d[index]) > 0.000000001 then
            local first = (-h[index] - o[index]) / d[index]
            local last = (h[index] - o[index]) / d[index]
            if first > 0 then cuts[#cuts + 1] = first end
            if last > 0 then cuts[#cuts + 1] = last end
        end
    end
    table.sort(cuts)
    local bestDistance, bestT, bestPoint = math.huge, math.huge, nil
    for index = 1, #cuts do
        local lower, upper = cuts[index], cuts[index + 1] or math.huge
        local sample = upper < math.huge and (lower + (upper - lower) * 0.5)
            or (lower + math.max(1, math.abs(lower) * 0.01))
        local a, b = 0, 0
        for axis = 1, 3 do
            local position = o[axis] + d[axis] * sample
            local bound
            if position < -h[axis] then bound = -h[axis]
            elseif position > h[axis] then bound = h[axis] end
            if bound then
                a = a + d[axis] * d[axis]
                b = b + d[axis] * (o[axis] - bound)
            end
        end
        local t = a > 0.000000000001 and math.clamp(-b / a, lower, upper)
            or math.clamp(preferred, lower, upper)
        local x, y, z = o[1] + d[1] * t, o[2] + d[2] * t, o[3] + d[3] * t
        local qx, qy, qz = math.clamp(x, -h[1], h[1]), math.clamp(y, -h[2], h[2]), math.clamp(z, -h[3], h[3])
        local distance = (x - qx) ^ 2 + (y - qy) ^ 2 + (z - qz) ^ 2
        if distance < bestDistance - 0.000000001
            or (math.abs(distance - bestDistance) <= 0.000000001 and math.abs(t - preferred) < math.abs(bestT - preferred)) then
            bestDistance, bestT = distance, t
            bestPoint = Vector3.new(qx, qy, qz)
        end
    end
    return bestPoint or Vector3.new(0, 0, 0)
end

local function buildSelector(ctx)
    local Players = ctx.Players
    local LocalPlayer = ctx.LocalPlayer
    local ReplicatedStorage = ctx.ReplicatedStorage
    local Settings = ctx.Settings
    local Clock = ctx.Clock or os.clock
    local World = ctx.Workspace or workspace
    local SCAN_INTERVAL = 1 / 30
    local PART_BUDGET = 192
    local RAY_BUDGET = 12
    local SHOT_RAY_BUDGET = 24
    local RETAINED_RAY_BUDGET = 4
    local MAX_PROBE_ATTEMPTS = 96
    local PING_INTERVAL = 0.25
    local MAX_AUTO_LEAD = 0.15
    local MAX_TRACKED_SPEED = 150
    local EPSILON = 0.0001
    local BODY_PARTS = {
        "Head", "UpperTorso", "LowerTorso", "Torso", "HumanoidRootPart",
        "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
        "LeftHand", "RightHand", "LeftUpperLeg", "RightUpperLeg",
        "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot",
        "Left Arm", "Right Arm", "Left Leg", "Right Leg",
    }
    local OFFSETS = {
        ["[Revolver]"] = CFrame.new(-1, 0.4, 0),
        ["[TacticalShotgun]"] = CFrame.new(0, 0.25, -2.5),
        ["[SilencerAR]"] = CFrame.new(2.5, 0.35, 0),
    }
    local UNIT_OFFSETS = {
        Vector3.new(0, 0, 0),
        Vector3.new(0, 0, 0),
        Vector3.new(0, 1, 0), Vector3.new(0, -1, 0),
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(1, 1, 1), Vector3.new(-1, 1, 1),
        Vector3.new(1, 1, -1), Vector3.new(-1, 1, -1),
        Vector3.new(1, -1, 1), Vector3.new(-1, -1, 1),
        Vector3.new(1, -1, -1), Vector3.new(-1, -1, -1),
    }

    local alive = true
    local epoch = 0
    local roster = {}
    local rosterAt = -math.huge
    local playerCursor, partCursor = 1, 1
    local records = {}
    local selected
    local currentTool
    local nextScan = 0
    local manualPlayer, manualCharacter, manualRequested, manualRequestUntil
    local reactionPlayer, reactionCharacter, reactionSince
    local normalParts = {}
    local originalAimCache = {}
    local motionHistory = {}
    local networkPing, pingReady, pingAt, nextPingAt = 0, false, -math.huge, -math.huge
    local lastGatherEpoch, lastGatherAt = -1, -math.huge
    local recoveryStamp
    local fovVisuals = { shape = "Circle", enabled = true, radius = 100, boxes = {} }
    local diagnostics = {
        targetName = "None", status = "Waiting for a weapon", scanMs = 0, raycasts = 0,
        pingMs = 0, predictionMs = 0, predictionMode = "Manual",
    }

    local ignoredObjects
    local mainModule = ReplicatedStorage:FindFirstChild("MainModule")
    if mainModule and mainModule:IsA("ModuleScript") then
        local ok, module = pcall(require, mainModule)
        if ok and type(module) == "table" and type(module.Ignored) == "table" then
            ignoredObjects = module.Ignored
        end
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    local wallParams = RaycastParams.new()
    wallParams.FilterType = Enum.RaycastFilterType.Exclude
    wallParams.RespectCanCollide = true

    local function finite(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end

    local function positive(value)
        return finite(value) and value > 0
    end

    local function finiteVector(value)
        return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
    end

    local function predictionWindow(now)
        local manual = finite(Settings.AimPredictionMs) and math.clamp(Settings.AimPredictionMs, 0, 250) / 1000 or 0
        if Settings.AutoPrediction ~= true then
            diagnostics.predictionMode, diagnostics.predictionMs = "Manual", manual * 1000
            return manual
        end
        if now >= nextPingAt then
            nextPingAt = now + PING_INTERVAL
            local ok, value = pcall(function() return LocalPlayer:GetNetworkPing() end)
            if ok and finite(value) and value >= 0 and value <= 2 then
                if pingReady and now - pingAt <= 1.5 then
                    networkPing = networkPing + math.clamp(value - networkPing, -0.1, 0.1) * 0.35
                else
                    networkPing = value
                end
                pingReady, pingAt = true, now
            end
        end
        local available = pingReady and now - pingAt <= 1.5
        local lead = available and math.clamp(networkPing * 0.5, 0, MAX_AUTO_LEAD) or 0
        diagnostics.pingMs = available and networkPing * 1000 or 0
        diagnostics.predictionMs = lead * 1000
        diagnostics.predictionMode = available and "Automatic" or "Automatic unavailable"
        return lead
    end

    local function characterMotion(record, view)
        local cached = view.motion[record.character]
        if cached then return cached end
        local zero = Vector3.new(0, 0, 0)
        local root = getCharacterFOVRoot(record.character) or record.part
        local position, velocity = root.Position, root.AssemblyLinearVelocity
        local valid = finiteVector(position) and finiteVector(velocity) and velocity.Magnitude <= MAX_TRACKED_SPEED
        local now = view.now
        local previous = motionHistory[record.character]
        if not valid then
            motionHistory[record.character] = nil
            view.motion[record.character] = zero
            return zero
        end
        if not previous or previous.root ~= root or now < previous.at or now - previous.at > 0.5 then
            previous = {
                root = root, player = record.player, at = now, position = position,
                movedAt = now, velocity = velocity, stability = 1, suppressUntil = 0,
            }
            motionHistory[record.character] = previous
        else
            local dt = now - previous.at
            local displacement = position - previous.position
            local distance = displacement.Magnitude
            local limit = math.max(12, math.max(velocity.Magnitude, previous.velocity.Magnitude) * dt * 3 + 4)
            if distance > limit then
                previous.velocity, previous.stability, previous.suppressUntil = zero, 0, now + 0.12
                previous.movedAt = now
            else
                if distance > 0.001 then previous.movedAt = now end
                local speed, oldSpeed = velocity.Magnitude, previous.velocity.Magnitude
                if speed < 0.5 then
                    previous.velocity, previous.stability = zero, 1
                elseif oldSpeed > 0.5 and velocity:Dot(previous.velocity) < speed * oldSpeed * 0.25 then
                    previous.velocity, previous.stability = velocity, 0.35
                elseif dt > 0 then
                    local alpha = math.clamp(dt * 18, 0, 1)
                    previous.velocity = previous.velocity + (velocity - previous.velocity) * alpha
                    previous.stability = math.min(1, previous.stability + dt * 8)
                end
            end
            previous.at, previous.position = now, position
        end
        local staleAfter = math.clamp(view.lead * 2 + 0.1, 0.18, 0.4)
        local staleScale = math.clamp(1 - (now - previous.movedAt - staleAfter) / 0.15, 0, 1)
        local result = now < previous.suppressUntil and zero or previous.velocity * previous.stability * staleScale
        view.motion[record.character] = result
        return result
    end

    local function isAllParts()
        return Settings.Target == "Closest" or Settings.Target == "ClosestPart" or Settings.Target == "ClosestPoint"
    end

    local function isClosestPoint()
        return Settings.Target == "ClosestPoint"
    end

    local function manualMode()
        return Settings.Mode == "CurrentTarget"
    end

    local function resetReaction()
        reactionPlayer, reactionCharacter, reactionSince = nil, nil, nil
    end

    local function updateReaction(record, now)
        if not record then resetReaction(); return end
        if reactionPlayer ~= record.player or reactionCharacter ~= record.character then
            reactionPlayer, reactionCharacter, reactionSince = record.player, record.character, now
        end
    end

    local function exempt(character)
        if character:GetAttribute("AdminInvisible") == true then return true end
        local flight = character:FindFirstChild("BatmanFlight")
        return character:GetAttribute("BatmanFlight") == true
            and flight ~= nil and flight:GetAttribute("HumanoidFlight") ~= true
    end

    local function eligible(player, expectedCharacter)
        if player == LocalPlayer or player.Parent ~= Players then return nil end
        local character = player.Character
        if not character or (expectedCharacter and character ~= expectedCharacter) or not character.Parent then
            return nil
        end
        if exempt(character) then return nil end
        if Settings.TeamCheck and LocalPlayer.Team ~= nil and not LocalPlayer.Neutral
            and not player.Neutral and player.Team == LocalPlayer.Team then
            return nil
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return nil end
        local effects = character:FindFirstChild("BodyEffects")
        local dead = effects and effects:FindFirstChild("Dead")
        if dead and dead.Value == true then return nil end
        if Settings.SkipKnocked then
            local knocked = effects and effects:FindFirstChild("K.O")
            if knocked and knocked.Value == true then return nil end
        end
        return character
    end

    local function equipped()
        local character = LocalPlayer.Character
        if not character then return nil end
        local tool = character:FindFirstChildWhichIsA("Tool")
        local handle = tool and tool:FindFirstChild("Handle")
        local rangeObject = tool and tool:FindFirstChild("Range")
        if not handle or not handle:IsA("BasePart") or not rangeObject
            or not (rangeObject:IsA("NumberValue") or rangeObject:IsA("IntValue"))
            or not positive(rangeObject.Value) then
            return nil
        end
        local default = tool:FindFirstChild("Default")
        local mesh = default and default:FindFirstChild("Mesh")
        local muzzle = mesh and mesh:FindFirstChild("Muzzle")
        local origin
        if muzzle and muzzle:IsA("Attachment") then
            origin = muzzle.WorldPosition
        elseif OFFSETS[tool.Name] then
            origin = (handle.CFrame * OFFSETS[tool.Name]).Position
        else
            muzzle = handle:FindFirstChild("Muzzle")
            origin = muzzle and muzzle:IsA("Attachment") and muzzle.WorldPosition or handle.Position
        end
        return tool, origin, rangeObject.Value
    end

    local function refreshFilters(now)
        local oldPlayer = roster[playerCursor]
        roster = Players:GetPlayers()
        playerCursor = 1
        if oldPlayer then
            for index, player in ipairs(roster) do
                if player == oldPlayer then playerCursor = index; break end
            end
        end
        local excluded, wallExcluded = {}, {}
        local function append(list, object)
            if typeof(object) == "Instance" then list[#list + 1] = object end
        end
        append(excluded, LocalPlayer.Character)
        local playerFolder = World:FindFirstChild("Players")
        append(wallExcluded, playerFolder or LocalPlayer.Character)
        if ignoredObjects then
            for _, object in pairs(ignoredObjects) do
                append(excluded, object)
                append(wallExcluded, object)
            end
        else
            local ignored = World:FindFirstChild("Ignored")
            append(excluded, ignored)
            append(wallExcluded, ignored)
        end

        for _, player in ipairs(roster) do
            local character = player.Character
            if character then
                if exempt(character) then append(excluded, character) end
                append(excluded, character:FindFirstChildWhichIsA("Tool"))
            end
        end
        rayParams.FilterDescendantsInstances = excluded
        wallParams.FilterDescendantsInstances = wallExcluded
        for character, motion in pairs(motionHistory) do
            if not character.Parent or motion.player.Character ~= character then motionHistory[character] = nil end
        end
        rosterAt = now
    end

    local function raycast(origin, direction, params)
        diagnostics.raycasts = diagnostics.raycasts + 1
        return World:Raycast(origin, direction, params)
    end

    local function wallClear(origin)
        if not Players:GetAttribute("RankedWallShotsBanned") then return true end
        local character = LocalPlayer.Character
        local head = character and character:FindFirstChild("Head")
        if not head or not head:IsA("BasePart") then return false end
        local delta = origin - head.Position
        if delta:Dot(delta) <= EPSILON then return true end
        return raycast(head.Position, delta, wallParams) == nil
    end

    local function pointScore(camera, pointer, point, origin, range, character, profile, aimRay, boxCache)
        if not finiteVector(point) then return nil end
        local delta = point - origin
        local distanceSquared = delta:Dot(delta)
        if distanceSquared <= EPSILON or distanceSquared > range * range then return nil end
        local pixel, onScreen = camera:WorldToViewportPoint(point)
        if not onScreen or pixel.Z <= 0 then return nil end
        local dx, dy = pixel.X - pointer.X, pixel.Y - pointer.Y
        local score = dx * dx + dy * dy
        if profile.enabled then
            if profile.shape == "Circle" then
                if profile.radius <= 0 or score > profile.radius * profile.radius then return nil end
            else
                local allowed = boxCache and boxCache[character]
                if allowed == nil then
                    local root = getCharacterFOVRoot(character)
                    allowed = root ~= nil and rayIntersectsBox(aimRay, root.CFrame, Vector3.new(profile.z, profile.y, profile.x))
                    if boxCache then boxCache[character] = allowed end
                end
                if not allowed then return nil end
            end
        end
        return score, delta, math.sqrt(distanceSquared)
    end

    local function nearestOffset(record, aimRay)
        local part = record.part
        local frame, size = part.CFrame, part.Size
        local cached = record.closestGeometry
        if cached and cached.frame == frame and cached.size == size
            and cached.origin == aimRay.Origin and cached.direction == aimRay.Direction then
            return cached.point
        end
        local point = closestRayBoxPoint(frame, size, aimRay)
        record.closestGeometry = {
            frame = frame, size = size, origin = aimRay.Origin, direction = aimRay.Direction, point = point,
        }
        return point
    end

    local function offsetAt(record, index, aimRay)
        local part = record.part
        if isClosestPoint() then
            if index == 2 then return Vector3.new(0, 0, 0) end
            if index == 1 then return nearestOffset(record, aimRay) end
            local half = part.Size * 0.5
            if index <= 8 then
                local nearest = nearestOffset(record, aimRay)
                local spacing = finite(Settings.PointScale) and math.clamp(Settings.PointScale, 0.05, 1) or 0.25
                local point = nearest + UNIT_OFFSETS[index] * spacing
                return Vector3.new(math.clamp(point.X, -half.X, half.X),
                    math.clamp(point.Y, -half.Y, half.Y), math.clamp(point.Z, -half.Z, half.Z))
            end
            return half * 0.95 * UNIT_OFFSETS[index - 6]
        end
        if index == 1 or Settings.Target == "ClosestPart" or Settings.Target == "Closest"
            or Settings.PointMode ~= "Adaptive" then
            return Vector3.new(0, 0, 0)
        end

        local half = part.Size * 0.38
        if index == 2 then
            local localPoint = nearestOffset(record, aimRay)
            return Vector3.new(
                math.clamp(localPoint.X, -half.X, half.X),
                math.clamp(localPoint.Y, -half.Y, half.Y),
                math.clamp(localPoint.Z, -half.Z, half.Z)
            )
        end
        return half * UNIT_OFFSETS[index]
    end

    local function sampleCount()
        if isClosestPoint() then return 22 end
        if Settings.Target == "ClosestPart" or Settings.Target == "Closest" then return 1 end
        return Settings.PointMode == "Adaptive" and #UNIT_OFFSETS or 1
    end

    local function pointsAt(record, index, view)
        local offset = offsetAt(record, index, view.aimRay)
        local point = record.part.CFrame:PointToWorldSpace(offset)
        if view.lead > 0 then
            local velocity = characterMotion(record, view)
            if velocity:Dot(velocity) > EPSILON then
                local localLead = record.part.CFrame:VectorToObjectSpace(velocity * view.lead)
                local half = record.part.Size * 0.42
                local destination = offset + localLead
                local bounded = Vector3.new(
                    math.clamp(destination.X, -half.X, half.X),
                    math.clamp(destination.Y, -half.Y, half.Y),
                    math.clamp(destination.Z, -half.Z, half.Z)
                )
                return point, record.part.CFrame:PointToWorldSpace(bounded), offset
            end
        end
        return point, point, offset
    end

    local function recordValid(record)
        return record ~= nil and record.part.Parent ~= nil
            and eligible(record.player, record.character) ~= nil
            and record.part:IsDescendantOf(record.character)
    end

    local function visible(candidate, origin, budget)
        if not Settings.VisibleOnly then return true end
        if budget and diagnostics.raycasts >= budget then return nil end
        local character = candidate.record.character
        local hit = raycast(origin, candidate.aimPoint - origin, rayParams)
        if hit and hit.Instance:IsDescendantOf(character) then return true end
        if candidate.point ~= candidate.aimPoint then
            if budget and diagnostics.raycasts >= budget then return nil end
            hit = raycast(origin, candidate.point - origin, rayParams)
            if hit and hit.Instance:IsDescendantOf(character) then
                candidate.aimPoint = candidate.point
                candidate.delta = candidate.point - origin
                candidate.distance = candidate.delta.Magnitude
                return true
            end
        end
        return false
    end

    local function clearSelection(status)
        selected = nil
        diagnostics.targetName = "None"
        if status then diagnostics.status = status end
    end

    local function commit(candidate, now)
        if not candidate then return end
        selected = {
            record = candidate.record, offset = candidate.offset,
            pointIndex = candidate.pointIndex, score = candidate.score, checkedAt = now,
        }
        diagnostics.targetName = candidate.record.player.Name
    end

    local function nearestPart(character, camera, pointer)
        local best, bestScore
        for _, name in ipairs(BODY_PARTS) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                local pixel, onScreen = camera:WorldToViewportPoint(part.Position)
                if onScreen and pixel.Z > 0 then
                    local score = (pixel.X - pointer.X) ^ 2 + (pixel.Y - pointer.Y) ^ 2
                    if not bestScore or score < bestScore then best, bestScore = part, score end
                end
            end
        end
        return best
    end

    local function nearestPartInView(character, view)
        local cache = view.nearestParts
        if not cache then cache = {}; view.nearestParts = cache end
        local part = cache[character]
        if part == nil then
            part = nearestPart(character, view.camera, view.pointer) or false
            cache[character] = part
        end
        return part or nil
    end

    local function updateRecord(player, character, part, view, now)
        if not part or not part:IsA("BasePart") then return nil end
        local record = records[part]
        if not record or record.character ~= character then
            record = { player = player, character = character, part = part, pointIndex = 1, probeAt = -math.huge }
        end
        local primary = pointsAt(record, 1, view)
        local first = pointScore(view.camera, view.pointer, primary, view.origin, view.range,
            character, view.profile, view.aimRay, view.boxCache)
        local second
        if sampleCount() > 1 then
            local alternative = pointsAt(record, 2, view)
            second = pointScore(view.camera, view.pointer, alternative, view.origin, view.range,
                character, view.profile, view.aimRay, view.boxCache)
        end
        if first or second then
            record.score = math.min(first or math.huge, second or math.huge)
            record.seenAt = now
            records[part] = record
            return record
        end
        records[part] = nil
        return nil
    end

    local function playerBefore(a, b)
        local first, second = a.UserId or 0, b.UserId or 0
        if first ~= second then return first < second end
        return a.Name < b.Name
    end

    local function gather(view, now)
        local ranked = {}
        local normal = isClosestPoint() and Settings.ClosestPointMode ~= "Advanced"
        for _, player in ipairs(roster) do
            local character = eligible(player)
            if character then
                local part = not isAllParts() and character:FindFirstChild(Settings.Target)
                    or character:FindFirstChild("Head") or getCharacterFOVRoot(character)
                local score, onScreen = math.huge, false
                if part and part:IsA("BasePart") then
                    local pixel, shown = view.camera:WorldToViewportPoint(part.Position)
                    onScreen = shown and pixel.Z > 0
                    if pixel.Z > 0 and finite(pixel.X) and finite(pixel.Y) then
                        score = (pixel.X - view.pointer.X) ^ 2 + (pixel.Y - view.pointer.Y) ^ 2
                    end
                end
                if isAllParts() and not onScreen then
                    local root = getCharacterFOVRoot(character)
                    if root and root ~= part then
                        local pixel = view.camera:WorldToViewportPoint(root.Position)
                        if pixel.Z > 0 and finite(pixel.X) and finite(pixel.Y) then
                            score = math.min(score, (pixel.X - view.pointer.X) ^ 2 + (pixel.Y - view.pointer.Y) ^ 2)
                        end
                    end
                end
                if onScreen or isAllParts() then
                    ranked[#ranked + 1] = {
                        player = player, character = character, part = part, score = score,
                    }
                end
            end
        end
        table.sort(ranked, function(a, b)
            if a.score ~= b.score then return a.score < b.score end
            return playerBefore(a.player, b.player)
        end)
        local spent = 0
        for _, item in ipairs(ranked) do
            local cost = normal and #BODY_PARTS or 1
            if spent + cost > PART_BUDGET then break end
            local part = item.part
            if normal then
                part = nearestPartInView(item.character, view)
                normalParts[item.character] = part
            end
            updateRecord(item.player, item.character, part, view, now)
            spent = spent + cost
        end
        if isAllParts() and not normal and #ranked > 0 and spent < PART_BUDGET then
            local firstPart = math.clamp(partCursor, 2, #BODY_PARTS)
            local firstPlayer = math.clamp(playerCursor, 1, #ranked)
            for offset = 0, #BODY_PARTS - 2 do
                local index = (firstPart - 2 + offset) % (#BODY_PARTS - 1) + 2
                for step = 0, #ranked - 1 do
                    local rankIndex = (firstPlayer - 1 + step) % #ranked + 1
                    local item = ranked[rankIndex]
                    local part = item.character:FindFirstChild(BODY_PARTS[index])
                    if part and part:IsA("BasePart") then
                        if spent >= PART_BUDGET then
                            partCursor, playerCursor = index, rankIndex
                            lastGatherEpoch, lastGatherAt = epoch, now
                            return
                        end
                        updateRecord(item.player, item.character, part, view, now)
                        spent = spent + 1
                    end
                end
            end
            partCursor = firstPart % (#BODY_PARTS - 1) + 2
            playerCursor = firstPlayer % #ranked + 1
        end
        lastGatherEpoch, lastGatherAt = epoch, now
    end

    local function seedPlayer(player, character, view, now)
        if not player or not character or not eligible(player, character) then return end
        if isClosestPoint() and Settings.ClosestPointMode ~= "Advanced" then
            local part = nearestPartInView(character, view)
            normalParts[character] = part
            updateRecord(player, character, part, view, now)
        elseif isAllParts() then
            for _, name in ipairs(BODY_PARTS) do
                updateRecord(player, character, character:FindFirstChild(name), view, now)
            end
        else
            updateRecord(player, character, character:FindFirstChild(Settings.Target), view, now)
        end
    end

    local function liveCandidate(record, index, view)
        if not recordValid(record) then return nil end
        if not isAllParts() and record.part.Name ~= Settings.Target then return nil end
        if isClosestPoint() and Settings.ClosestPointMode ~= "Advanced"
            and normalParts[record.character] ~= record.part then return nil end
        index = math.clamp(index or 1, 1, sampleCount())
        local point, aimPoint, offset = pointsAt(record, index, view)
        local score, delta, distance = pointScore(view.camera, view.pointer, point, view.origin,
            view.range, record.character, view.profile, view.aimRay, view.boxCache)
        if not score then return nil end
        if aimPoint ~= point then
            local allowed, predictedDelta, predictedDistance = pointScore(view.camera, view.pointer, aimPoint,
                view.origin, view.range, record.character, view.profile, view.aimRay, view.boxCache)
            if allowed then delta, distance = predictedDelta, predictedDistance
            else aimPoint = point end
        end
        return {
            record = record, pointIndex = index, point = point, aimPoint = aimPoint,
            offset = offset, score = score, delta = delta, distance = distance,
        }
    end

    local function better(candidate, winner)
        if not winner then return true end
        if candidate.score ~= winner.score then return candidate.score < winner.score end
        if candidate.record.player ~= winner.record.player then
            return playerBefore(candidate.record.player, winner.record.player)
        end
        if candidate.record.part.Name ~= winner.record.part.Name then
            return candidate.record.part.Name < winner.record.part.Name
        end
        return candidate.pointIndex < winner.pointIndex
    end

    local function makeEntry(record, view, prior)
        local queue, used, cache = {}, {}, {}
        local function append(index)
            index = math.clamp(index or 1, 1, sampleCount())
            if not used[index] then used[index] = true; queue[#queue + 1] = index end
        end
        append(1)
        if prior and prior.record.part == record.part then append(prior.pointIndex) end
        append(record.pointIndex)
        if sampleCount() > 1 then append(2) end
        local bestScore
        for _, index in ipairs(queue) do
            local candidate = liveCandidate(record, index, view)
            cache[index] = candidate or false
            if candidate then bestScore = math.min(bestScore or math.huge, candidate.score) end
        end
        if not bestScore then return nil end
        local first = math.clamp(record.pointIndex or 1, 1, sampleCount())
        for step = 0, sampleCount() - 1 do append((first - 1 + step) % sampleCount() + 1) end
        return { record = record, score = bestScore, queue = queue, cursor = 1, cache = cache }
    end

    local function collectGroups(view, now, prior, onlyPlayer)
        local groups, byPlayer = {}, {}
        local bodyCount = isAllParts() and #BODY_PARTS or 1
        local maxAge = math.max(0.3, #roster * bodyCount / PART_BUDGET * SCAN_INTERVAL * 2 + 0.1)
        for part, record in pairs(records) do
            if now - record.seenAt > maxAge or not recordValid(record) then
                records[part] = nil
            elseif not onlyPlayer or record.player == onlyPlayer then
                local entry = makeEntry(record, view, prior)
                if entry then
                    local group = byPlayer[record.player]
                    if not group then
                        group = { player = record.player, character = record.character, entries = {}, cursor = 1, score = entry.score }
                        byPlayer[record.player] = group
                        groups[#groups + 1] = group
                    end
                    group.entries[#group.entries + 1] = entry
                    group.score = math.min(group.score, entry.score)
                end
            end
        end
        for _, group in ipairs(groups) do
            table.sort(group.entries, function(a, b)
                if a.score ~= b.score then return a.score < b.score end
                return a.record.part.Name < b.record.part.Name
            end)
        end
        table.sort(groups, function(a, b)
            if a.score ~= b.score then return a.score < b.score end
            return playerBefore(a.player, b.player)
        end)
        return groups, byPlayer
    end

    local function probeGroups(groups, view, now, budget, winner, checked)
        local attempts = 0
        while attempts < MAX_PROBE_ATTEMPTS and diagnostics.raycasts < budget do
            local progressed = false
            for _, group in ipairs(groups) do
                if attempts >= MAX_PROBE_ATTEMPTS or diagnostics.raycasts >= budget then break end
                local entry
                for _ = 1, #group.entries do
                    local candidateEntry = group.entries[group.cursor]
                    group.cursor = group.cursor % #group.entries + 1
                    if not candidateEntry.done and candidateEntry.cursor <= #candidateEntry.queue then
                        entry = candidateEntry
                        break
                    end
                end
                if entry then
                    progressed = true
                    attempts = attempts + 1
                    local index = entry.queue[entry.cursor]
                    entry.cursor = entry.cursor + 1
                    local candidate = entry.cache[index]
                    if candidate == nil then candidate = liveCandidate(entry.record, index, view) end
                    local result
                    if candidate then
                        local same = checked and checked.record.part == candidate.record.part
                            and checked.pointIndex == candidate.pointIndex
                        if same then candidate, result = checked, true
                        else result = visible(candidate, view.origin, budget) end
                        if result == nil then return winner end
                    end
                    entry.record.probeAt = now
                    if result then
                        entry.done = true
                        entry.record.pointIndex = 1
                        if better(candidate, winner) then winner = candidate end
                    else
                        entry.record.pointIndex = index % sampleCount() + 1
                    end
                end
            end
            if not progressed then break end
        end
        return winner
    end

    local function acquire(view, now, budget, prior, checked, forceGather)
        if forceGather or lastGatherEpoch ~= epoch or now - lastGatherAt >= SCAN_INTERVAL then gather(view, now) end
        local retainedPlayer, retainedCharacter
        if manualMode() and manualPlayer then
            retainedPlayer, retainedCharacter = manualPlayer, manualCharacter
        elseif Settings.KeepTarget and prior and eligible(prior.record.player, prior.record.character) then
            retainedPlayer, retainedCharacter = prior.record.player, prior.record.character
        end
        seedPlayer(retainedPlayer, retainedCharacter, view, now)
        if prior and recordValid(prior.record) then
            prior.record.seenAt = now
            records[prior.record.part] = prior.record
        end
        local groups, byPlayer = collectGroups(view, now, prior, manualMode() and manualPlayer or nil)
        if retainedPlayer then
            local retained = byPlayer[retainedPlayer]
            if checked and checked.record.player == retainedPlayer and not isAllParts() and checked.pointIndex == 1 then
                return checked
            end
            local winner = checked and checked.record.player == retainedPlayer and checked or nil
            if retained then
                local limit = manualMode() and budget or math.min(budget, diagnostics.raycasts + RETAINED_RAY_BUDGET)
                winner = probeGroups({ retained }, view, now, limit, winner, checked)
            end
            if winner or manualMode() then return winner end
            local alternatives = {}
            for _, group in ipairs(groups) do
                if group.player ~= retainedPlayer then alternatives[#alternatives + 1] = group end
            end
            winner = probeGroups(alternatives, view, now, budget, nil, checked)
            if not winner and retained then winner = probeGroups({ retained }, view, now, budget, nil, checked) end
            return winner
        end
        return probeGroups(groups, view, now, budget, checked, checked)
    end

    local function makeView(origin, range, camera, pointer, profile, now)
        local view = {
            origin = origin, range = range, camera = camera, pointer = pointer, profile = profile,
            aimRay = camera:ViewportPointToRay(pointer.X, pointer.Y, 0), boxCache = {},
            now = now, lead = predictionWindow(now), motion = {},
        }
        if isClosestPoint() and Settings.ClosestPointMode ~= "Advanced" then view.nearestParts = {} end
        return view
    end

    local function sameRecovery(view, tool, now)
        local item = recoveryStamp
        return item ~= nil and item.epoch == epoch and now - item.at <= SCAN_INTERVAL
            and item.tool == tool and item.origin == view.origin and item.range == view.range
            and item.camera == view.camera and item.frame == view.camera.CFrame
            and item.fov == view.camera.FieldOfView and item.viewport == view.camera.ViewportSize
            and item.x == view.pointer.X and item.y == view.pointer.Y
            and item.mode == Settings.Mode and item.target == Settings.Target
            and item.keepTarget == Settings.KeepTarget and item.manualPlayer == manualPlayer
            and item.shape == view.profile.shape and item.enabled == view.profile.enabled
            and item.radius == view.profile.radius and item.width == view.profile.x
            and item.height == view.profile.y and item.depth == view.profile.z
    end

    local function stampRecovery(view, tool, now)
        recoveryStamp = {
            epoch = epoch, at = now, tool = tool, origin = view.origin, range = view.range,
            camera = view.camera, frame = view.camera.CFrame, fov = view.camera.FieldOfView,
            viewport = view.camera.ViewportSize, x = view.pointer.X, y = view.pointer.Y,
            mode = Settings.Mode, target = Settings.Target, keepTarget = Settings.KeepTarget,
            manualPlayer = manualPlayer, shape = view.profile.shape, enabled = view.profile.enabled,
            radius = view.profile.radius, width = view.profile.x, height = view.profile.y, depth = view.profile.z,
        }
    end

    local selector = {}

    function selector:Invalidate(preserveManualLock)
        clearSelection("Updating target")
        records = {}
        normalParts = {}
        originalAimCache = {}
        motionHistory = {}
        resetReaction()
        if not preserveManualLock then manualPlayer, manualCharacter, manualRequested, manualRequestUntil = nil, nil, false, nil end
        nextScan = 0
        lastGatherEpoch, lastGatherAt, recoveryStamp = -1, -math.huge, nil
        playerCursor, partCursor = 1, 1
        rosterAt = -math.huge
    end

    function selector:Step(_dt)
        if not alive then return end
        if not Settings.Enabled then
            clearSelection("Disabled")
            resetReaction()
            diagnostics.scanMs, diagnostics.raycasts = 0, 0
            fovVisuals.enabled = false
            table.clear(fovVisuals.boxes)
            return
        end
        epoch = epoch + 1
        originalAimCache = {}
        diagnostics.raycasts = 0
        local now = Clock()
        local tool, origin, range = equipped()
        if tool ~= currentTool then
            currentTool = tool
            self:Invalidate(true)
        end
        local profile = getFOVProfile(Settings, tool)
        if now - rosterAt >= 0.2 then
            refreshFilters(now)
        end
        local boxes = {}
        if Settings.ShowFOV and profile.enabled and profile.shape == "Box"
            and profile.x > 0 and profile.y > 0 and profile.z > 0 then
            local size = Vector3.new(profile.z, profile.y, profile.x)
            for index = 1, math.min(#roster, 64) do
                local character = eligible(roster[index])
                local root = character and getCharacterFOVRoot(character)
                if root then boxes[#boxes + 1] = { part = root, size = size } end
            end
        end
        fovVisuals = { shape = profile.shape, enabled = profile.enabled, radius = profile.radius, boxes = boxes }
        if not tool then clearSelection("Waiting for a weapon"); resetReaction(); return end
        if manualMode() then
            if manualRequested and (not manualRequestUntil or now >= manualRequestUntil) then
                manualRequested, manualRequestUntil = false, nil
                clearSelection("No eligible target; press target key")
                resetReaction()
            end
            if manualPlayer and not eligible(manualPlayer, manualCharacter) then
                manualPlayer, manualCharacter, manualRequested, manualRequestUntil = nil, nil, false, nil
                clearSelection("Target lost; press target key")
                resetReaction()
            end
            if not manualPlayer and not manualRequested then
                clearSelection("Press target key to select")
                resetReaction()
                return
            end
        end
        if now < nextScan then return end
        nextScan = now + SCAN_INTERVAL
        local started = Clock()
        local camera = World.CurrentCamera
        if not camera then clearSelection("Waiting for camera"); resetReaction(); return end
        local pointer = ctx.ReferencePoint(camera)
        local view = makeView(origin, range, camera, pointer, profile, now)
        if not wallClear(origin) then
            clearSelection("Muzzle is behind cover")
            resetReaction()
            diagnostics.scanMs = (Clock() - started) * 1000
            return
        end
        local prior = selected
        if prior and isClosestPoint() and Settings.ClosestPointMode ~= "Advanced" and recordValid(prior.record) then
            normalParts[prior.record.character] = nearestPartInView(prior.record.character, view)
        end
        gather(view, now)
        local checked = prior and liveCandidate(prior.record, prior.pointIndex, view) or nil
        if checked and not visible(checked, origin, RAY_BUDGET) then checked = nil end
        local winner = acquire(view, now, RAY_BUDGET, prior, checked)
        if winner then commit(winner, now) else clearSelection() end
        if manualMode() and manualRequested and selected then
            manualPlayer, manualCharacter, manualRequested = selected.record.player, selected.record.character, false
            manualRequestUntil = nil
        end
        updateReaction(selected and selected.record or nil, now)
        diagnostics.status = selected and "Tracking" or "Searching in FOV"
        diagnostics.scanMs = (Clock() - started) * 1000
    end

    local function correctionAllowed(origin, requestedRange, camera, pointer, direction)
        if type(ctx.OriginalAim) ~= "function" then return false end
        local mouse = ctx.UserInputService and ctx.UserInputService:GetMouseLocation() or pointer
        local originalDirection
        local found = false
        for index = 1, 4 do
            local entry = originalAimCache[index]
            if entry and entry.origin == origin and entry.range == requestedRange
                and entry.camera == camera and entry.frame == camera.CFrame
                and entry.fieldOfView == camera.FieldOfView and entry.viewport == camera.ViewportSize
                and entry.mouse == mouse and entry.mobile == _G.MobileShiftLock and entry.mobileAim == _G.MobleAimingIn then
                originalDirection, found = entry.direction, true
                break
            end
        end
        if not found then
            local ok, value = pcall(ctx.OriginalAim, origin, requestedRange)
            if ok and finiteVector(value) and value.Magnitude > 0.001 then originalDirection = value.Unit end
            local entry = {
                origin = origin, range = requestedRange, camera = camera, frame = camera.CFrame,
                fieldOfView = camera.FieldOfView, viewport = camera.ViewportSize, mouse = mouse,
                mobile = _G.MobileShiftLock, mobileAim = _G.MobleAimingIn, direction = originalDirection,
            }
            if #originalAimCache >= 4 then table.remove(originalAimCache, 1) end
            originalAimCache[#originalAimCache + 1] = entry
        end
        if not originalDirection then return false end
        local limit = finite(Settings.MaxCorrectionDegrees) and math.clamp(Settings.MaxCorrectionDegrees, 0, 45) or 8
        return math.clamp(direction:Dot(originalDirection), -1, 1) >= math.cos(math.rad(limit)) - 0.000000001
    end

    function selector:Get(origin, requestedRange)
        if not alive or not Settings.Enabled or not finiteVector(origin) then return nil end
        local now = Clock()
        local tool, _, range = equipped()
        if tool ~= currentTool then
            currentTool = tool
            self:Invalidate(true)
        end
        if not tool or not positive(range) then return nil end
        if requestedRange ~= nil then
            if not positive(requestedRange) then return nil end
            range = math.min(range, requestedRange)
        end
        if manualMode() then
            if manualPlayer and not eligible(manualPlayer, manualCharacter) then
                manualPlayer, manualCharacter, manualRequested, manualRequestUntil = nil, nil, false, nil
                clearSelection("Target lost; press target key")
                resetReaction()
                return nil
            end
            if not manualPlayer then
                if not manualRequested or not manualRequestUntil or now >= manualRequestUntil then return nil end
            end
        end
        local camera = World.CurrentCamera
        if not camera then return nil end
        if now - rosterAt >= 0.2 then refreshFilters(now) end
        local pointer = ctx.ReferencePoint(camera)
        local profile = getFOVProfile(Settings, tool)
        local view = makeView(origin, range, camera, pointer, profile, now)
        local budget = diagnostics.raycasts + SHOT_RAY_BUDGET
        if not wallClear(origin) then
            resetReaction()
            return nil
        end
        local prior = selected
        if prior and isClosestPoint() and Settings.ClosestPointMode ~= "Advanced" and recordValid(prior.record) then
            normalParts[prior.record.character] = nearestPartInView(prior.record.character, view)
        end
        local candidate = prior and liveCandidate(prior.record, prior.pointIndex, view) or nil
        if candidate and manualMode() and manualPlayer
            and (candidate.record.player ~= manualPlayer or candidate.record.character ~= manualCharacter) then candidate = nil end
        if candidate and not visible(candidate, origin, budget) then candidate = nil end
        local needsRanking = not candidate or not (Settings.KeepTarget or manualMode())
        local previousRecoverySucceeded = recoveryStamp and recoveryStamp.succeeded == true
        if needsRanking and (not sameRecovery(view, tool, now) or (not candidate and previousRecoverySucceeded)) then
            stampRecovery(view, tool, now)
            candidate = acquire(view, now, budget, prior, candidate, true)
            recoveryStamp.succeeded = candidate ~= nil
        end
        if not candidate then
            clearSelection("Searching in FOV")
            resetReaction()
            return nil
        end
        commit(candidate, now)
        if manualMode() and manualRequested and not manualPlayer then
            manualPlayer, manualCharacter, manualRequested = candidate.record.player, candidate.record.character, false
            manualRequestUntil = nil
        end
        local direction = candidate.delta / candidate.distance
        if Settings.Humanizer then
            updateReaction(candidate.record, now)
            local delay = finite(Settings.ReactionMs) and math.clamp(Settings.ReactionMs, 0, 400) or 100
            if (now - reactionSince) * 1000 + 0.000001 < delay then return nil end
            if not correctionAllowed(origin, requestedRange, camera, pointer, direction) then return nil end
        end
        diagnostics.status = "Tracking"
        return direction, candidate.distance, {
            part = candidate.record.part, point = candidate.point, aimPoint = candidate.aimPoint,
            character = candidate.record.character, player = candidate.record.player,
        }
    end

    function selector:ToggleTarget()
        if not alive then return false end
        if manualPlayer or manualRequested then
            manualPlayer, manualCharacter, manualRequested, manualRequestUntil = nil, nil, false, nil
            clearSelection("Target released")
            resetReaction()
            return false
        end
        if not Settings.Enabled then return false end
        manualRequested = true
        manualRequestUntil = Clock() + 0.25
        clearSelection("Selecting target")
        resetReaction()
        nextScan = 0
        recoveryStamp = nil
        return true
    end

    function selector:GetFOVVisuals()
        if not alive or not Settings.Enabled then
            fovVisuals.enabled = false
            table.clear(fovVisuals.boxes)
            return fovVisuals
        end
        local profile = getFOVProfile(Settings, currentTool)
        return { shape = profile.shape, enabled = profile.enabled, radius = profile.radius, boxes = fovVisuals.boxes }
    end

    function selector:GetDiagnostics()
        return {
            targetName = diagnostics.targetName, status = diagnostics.status,
            scanMs = diagnostics.scanMs, raycasts = diagnostics.raycasts,
            pingMs = diagnostics.pingMs, predictionMs = diagnostics.predictionMs,
            predictionMode = diagnostics.predictionMode,
        }
    end

    function selector:Destroy()
        alive = false
        clearSelection("Unloaded")
        resetReaction()
        manualPlayer, manualCharacter, manualRequested, manualRequestUntil = nil, nil, false, nil
        fovVisuals.boxes = {}
        records, roster, motionHistory = {}, {}, {}
    end

    return selector
end

local function buildShotRouter(ctx)
    local GunHandler = ctx.GunHandler
    local Selector = ctx.Selector
    local Settings = ctx.Settings
    local LocalPlayer = ctx.LocalPlayer
    local Visual = ctx.Visual
    local Hitbox = ctx.Hitbox
    local originalGetAim = GunHandler.getAim
    local originalShoot = GunHandler.shoot
    local originalSpread = GunHandler.shotgunSpread
    assert(type(originalGetAim) == "function", "GunHandler.getAim was not found")
    assert(type(originalShoot) == "function", "GunHandler.shoot was not found")
    assert(type(originalSpread) == "function", "GunHandler.shotgunSpread was not found")

    local rng = Random.new()
    local alive, installed, destroyed = true, false, false
    local generation = 0
    local contexts = setmetatable({}, { __mode = "k" })
    local mainThread = {}
    local BYPASS = {}
    local router = {}
    local redirectedGetAim, routedShoot, routedSpread

    local function report(area, problem)
        if type(ctx.OnError) == "function" then
            pcall(ctx.OnError, area, problem)
        end
    end

    local function threadRecord()
        local thread = coroutine.running() or mainThread
        local record = contexts[thread]
        if not record then
            record = { pending = nil, active = nil, insideAim = false, hitboxAimAllowed = true }
            contexts[thread] = record
        end
        return record
    end

    local function identity()
        local character = LocalPlayer.Character
        if not character or not character.Parent then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then return nil end
        local tool = character:FindFirstChildWhichIsA("Tool")
        if not tool then return nil end
        return character, tool
    end

    local function chanceValue()
        local value = Settings.HitChance
        if type(value) ~= "number" or value ~= value then return 100 end
        return math.clamp(value, 0, 100)
    end

    local function newAction(character, tool, remaining)
        return {
            shooter = character, tool = tool, generation = generation,
            chance = chanceValue(), decision = nil, remaining = remaining,
            aimResolved = false, aimPoint = nil, selectionInfo = nil,
        }
    end

    local function matches(action, character, tool)
        return action ~= nil and action ~= BYPASS
            and action.generation == generation
            and action.shooter == character and action.tool == tool
    end

    local function allows(action)
        if action.decision == nil then
            if action.chance <= 0 then
                action.decision = false
            elseif action.chance >= 100 then
                action.decision = true
            else
                action.decision = rng:NextNumber() < action.chance / 100
            end
        end
        return action.decision
    end

    local function finite(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end

    local function finiteVector(value)
        return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
    end

    local function snapshotValid(action)
        local info = action.selectionInfo
        if type(info) ~= "table" or not finiteVector(action.aimPoint) then return false end
        local part, character, player = info.part, info.character, info.player
        if not part or not part.Parent or not character or not character.Parent
            or not part:IsDescendantOf(character) then return false end
        if player and (not player.Parent or player.Character ~= character) then return false end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or not finite(humanoid.Health) or humanoid.Health <= 0 then return false end
        local effects = character:FindFirstChild("BodyEffects")
        local dead = effects and effects:FindFirstChild("Dead")
        if dead and dead.Value == true then return false end
        if Settings.SkipKnocked then
            local knocked = effects and effects:FindFirstChild("K.O")
            if knocked and knocked.Value == true then return false end
        end
        return true
    end

    local function snapshotAim(action, origin, requestedRange, distanceOnly)
        if not finiteVector(origin) then return nil end
        if not snapshotValid(action) then
            action.aimPoint, action.selectionInfo = nil, nil
            return nil
        end
        local rangeObject = action.tool:FindFirstChild("Range")
        local limit = rangeObject and rangeObject.Value
        if not finite(limit) or limit <= 0 then return nil end
        if requestedRange ~= nil then
            if not finite(requestedRange) or requestedRange <= 0 then return nil end
            limit = math.min(limit, requestedRange)
        end
        local delta = action.aimPoint - origin
        local distance = delta.Magnitude
        if not finite(distance) or distance <= 0.0001
            or (not distanceOnly and distance > limit + 0.0001) then
            action.aimPoint, action.selectionInfo = nil, nil
            return nil
        end
        return delta / distance, math.min(distance, limit)
    end

    local function resolveAim(record, origin, requestedRange)
        local character, tool = identity()
        if not character then
            record.pending = nil
            return nil
        end
        local action
        local outerCall = record.active == nil
        if not outerCall then
            if not matches(record.active, character, tool) then return nil end
            action = record.active
        else
            action = record.pending
            if not matches(action, character, tool) or action.remaining == nil then
                action = newAction(character, tool, nil)
                record.pending = action
            end
        end
        if not allows(action) then return nil end
        if not outerCall then
            if not action.aimResolved then return nil end
            return snapshotAim(action, origin, requestedRange, true)
        end
        if not action.aimResolved then
            action.aimResolved = true
            local direction, distance, info = Selector:Get(origin, requestedRange)
            if finiteVector(direction) and finite(distance) and distance > 0 and type(info) == "table" then
                local point = finiteVector(info.aimPoint) and info.aimPoint or origin + direction * distance
                if finiteVector(point) then
                    local snapshot = {}
                    for key, value in pairs(info) do snapshot[key] = value end
                    action.aimPoint, action.selectionInfo = point, snapshot
                end
            end
        end
        return snapshotAim(action, origin, requestedRange, false)
    end

    local function nativeAim(origin, ...)
        if not alive or not Hitbox or type(Hitbox.BeginAim) ~= "function" then
            return originalGetAim(origin, ...)
        end
        local record = threadRecord()
        local requestedRange = select(1, ...)
        local ok, token = pcall(Hitbox.BeginAim, Hitbox, origin, requestedRange, record.hitboxAimAllowed ~= false)
        if not ok then
            report("hitbox aim", token)
            error(token, 0)
        end
        local result = table.pack(pcall(originalGetAim, origin, ...))
        local cleanupFailure
        if token ~= nil then
            local ended, restored = pcall(Hitbox.EndAim, Hitbox, token)
            if not ended or restored == false then
                report("hitbox aim cleanup", ended and "Could not disable aim queries" or restored)
                local retried, released = pcall(Hitbox.Invalidate, Hitbox)
                if not retried or released == false then cleanupFailure = "Hitbox aim queries could not be disabled" end
            end
        end
        if not result[1] then error(result[2], 0) end
        if cleanupFailure then error(cleanupFailure, 0) end
        return table.unpack(result, 2, result.n)
    end

    redirectedGetAim = function(origin, ...)
        if alive and Settings.Enabled then
            local record = threadRecord()
            if not record.insideAim then
                record.insideAim = true
                local ok, direction, distance = pcall(resolveAim, record, origin, select(1, ...))
                record.insideAim = false
                if ok and direction then return direction, distance end
                if not ok then report("aim check", direction) end
            end
        end

        return nativeAim(origin, ...)
    end

    local function primaryShot(data, character, tool, previousActive)
        return previousActive == nil and type(data) == "table"
            and character ~= nil and data.Shooter == character
            and data.Handle ~= nil and data.Handle.Parent == tool
            and not (data.ReplicatedShot or data.IsLeftHand or data.isReflecting or data.TrailOnly)
    end

    routedShoot = function(data, ...)
        if not alive then return originalShoot(data, ...) end
        local record = threadRecord()
        local previousActive = record.active
        local previousAimAllowed = record.hitboxAimAllowed
        local character, tool = identity()
        local primary = primaryShot(data, character, tool, previousActive)
        local action = primary and record.pending or nil
        if not matches(action, character, tool) then action = nil end

        record.active = action or BYPASS

        local hitboxShot = type(data) == "table" and character ~= nil and data.Shooter == character
            and data.Handle ~= nil and data.Handle.Parent == tool
            and not (data.ReplicatedShot or data.isReflecting or data.TrailOnly)
        record.hitboxAimAllowed = hitboxShot and data.Hit == nil
        local hitboxToken
        if Hitbox and type(Hitbox.BeginShot) == "function" then
            local ok, token = pcall(Hitbox.BeginShot, Hitbox, data)
            if not ok then
                record.active = previousActive
                record.hitboxAimAllowed = previousAimAllowed
                if action and record.pending == action then record.pending = nil end
                report("hitbox shot", token)
                error(token, 0)
            end
            hitboxToken = token
        end

        local visualToken
        if primary and Visual and type(Visual.Begin) == "function" then
            local ok, token = pcall(Visual.Begin, Visual, data, action and action.selectionInfo or nil)
            if ok then visualToken = token else report("tracer begin", token) end
        end

        local result = table.pack(pcall(originalShoot, data, ...))
        record.active = previousActive
        record.hitboxAimAllowed = previousAimAllowed
        local hitboxCleanupFailure
        if hitboxToken ~= nil and Hitbox and type(Hitbox.EndShot) == "function" then
            local ok, restored = pcall(Hitbox.EndShot, Hitbox, hitboxToken)
            if not ok or restored == false then
                report("hitbox shot cleanup", ok and "Could not disable hitbox queries" or restored)
                local retried, released = pcall(Hitbox.Invalidate, Hitbox)
                if not retried or released == false then
                    hitboxCleanupFailure = "Hitbox queries could not be disabled"
                end
            end
        end
        if action and record.pending == action then
            if not result[1] then
                record.pending = nil
            elseif action.remaining then
                action.remaining = action.remaining - 1
                if action.remaining <= 0 then record.pending = nil end
            else
                record.pending = nil
            end
        end

        if visualToken ~= nil and Visual and type(Visual.Finish) == "function" then
            local ok, problem = pcall(Visual.Finish, Visual, visualToken, result[1])
            if not ok then report("tracer finish", problem) end
        end
        if not result[1] then error(result[2], 0) end
        if hitboxCleanupFailure then error(hitboxCleanupFailure, 0) end
        if hitboxShot and result.n >= 3 and Hitbox and type(Hitbox.ResolveHit) == "function" then
            local ok, owned, nativePart = pcall(Hitbox.ResolveHit, Hitbox, result[3], result[2], data)
            if ok then
                if owned then result[3] = nativePart end
            else
                result[3] = nil
                report("hitbox hit mapping", owned)
            end
        end
        return table.unpack(result, 2, result.n)
    end

    routedSpread = function(weaponName, ...)
        if not alive then return originalSpread(weaponName, ...) end
        local record = threadRecord()
        if record.active == nil then record.pending = nil end
        local result = table.pack(originalSpread(weaponName, ...))
        local character, tool = identity()
        local offsets = result[1]
        if character and tool.Name == weaponName and type(offsets) == "table" then
            if Settings.Enabled and record.active == nil then
                local pelletCount = 0
                for _ in pairs(offsets) do pelletCount = pelletCount + 1 end
                if pelletCount > 0 then
                    record.pending = newAction(character, tool, pelletCount)
                end
            end
            local percent = Settings.SpreadPercent
            if Settings.SpreadEnabled == true and type(percent) == "number"
                and percent == percent and math.abs(percent) < math.huge then
                local multiplier = math.clamp(percent, 0, 100) / 100
                if multiplier < 1 then
                    local adjusted = {}
                    for key, offset in pairs(offsets) do
                        adjusted[key] = typeof(offset) == "Vector3" and offset * multiplier or offset
                    end
                    result[1] = adjusted
                end
            end
        end
        return table.unpack(result, 1, result.n)
    end

    function router:Invalidate()
        generation = generation + 1
        contexts = setmetatable({}, { __mode = "k" })
    end

    function router:Install()
        if destroyed then error("The shot router has been unloaded", 0) end
        if installed then return true end
        if GunHandler.getAim ~= originalGetAim or GunHandler.shoot ~= originalShoot
            or GunHandler.shotgunSpread ~= originalSpread then
            error("GunHandler changed during setup; no functions were replaced", 0)
        end

        GunHandler.getAim = redirectedGetAim
        GunHandler.shoot = routedShoot
        GunHandler.shotgunSpread = routedSpread
        installed = true
        return true
    end

    function router:Destroy()
        alive, destroyed, installed = false, true, false
        self:Invalidate()
        local failures = {}
        local function restore(name, owned, original)
            local ok, problem = pcall(function()
                if GunHandler[name] == owned then GunHandler[name] = original end
            end)
            if not ok then failures[#failures + 1] = tostring(problem) end
        end

        restore("getAim", redirectedGetAim, originalGetAim)
        restore("shoot", routedShoot, originalShoot)
        restore("shotgunSpread", routedSpread, originalSpread)
        if #failures > 0 then error(table.concat(failures, " | "), 0) end
        return true
    end

    return router
end

local function buildVisualRedirect(ctx)
    local Settings, Player = ctx.Settings, ctx.LocalPlayer
    local World, Clock = ctx.Workspace or workspace, ctx.Clock or os.clock
    local alive = true
    local pending = {}
    local touched = setmetatable({}, {__mode = "k"})
    local claimed = setmetatable({}, {__mode = "k"})
    local generation = 0
    local folder, folderConnection
    local TTL, MAX_PENDING = 0.35, 128

    local function finite(number)
        return type(number) == "number" and number == number and math.abs(number) < math.huge
    end

    local function finiteVector(vector)
        return typeof(vector) == "Vector3" and finite(vector.X) and finite(vector.Y) and finite(vector.Z)
    end

    local function report(problem)
        if type(ctx.OnError) == "function" then pcall(ctx.OnError, "tracer appearance", problem) end
    end

    local function rotateDirection(from, to, direction)
        local cosine = math.clamp(from:Dot(to), -1, 1)
        local cross = from:Cross(to)
        local sineSquared = cross:Dot(cross)
        if sineSquared <= 0.000000000001 then
            if cosine >= 0 then return direction end
            local reference = math.abs(from.Y) < 0.9 and Vector3.new(0, 1, 0) or Vector3.new(1, 0, 0)
            local axis = from:Cross(reference).Unit
            return axis * (2 * axis:Dot(direction)) - direction
        end
        local sine = math.sqrt(sineSquared)
        local axis = cross / sine
        return direction * cosine + axis:Cross(direction) * sine
            + axis * (axis:Dot(direction) * (1 - cosine))
    end

    local function weaponAllowed(tool)
        return Settings["Redirect" .. classifyWeapon(tool)] == true
    end

    local function restore(part, record)
        if not part.Parent then return true end
        local complete = true
        local function attempt(callback)
            local ok, problem = pcall(callback)
            if not ok then complete = false; report(problem) end
        end

        attempt(function()
            if part.CFrame == record.appliedFrame then part.CFrame = record.originalFrame end
        end)
        attempt(function()
            local endpoint = record.endpoint
            if endpoint and endpoint.Parent == part and endpoint.Position == record.appliedPosition then
                endpoint.Position = record.originalPosition
            end
        end)
        attempt(function()
            local beam = record.beam
            if beam and beam.Parent == part and beam.CurveSize0 == 0 then beam.CurveSize0 = record.curve0 end
        end)
        attempt(function()
            local beam = record.beam
            if beam and beam.Parent == part and beam.CurveSize1 == 0 then beam.CurveSize1 = record.curve1 end
        end)
        return complete
    end

    local function invalidateRecords()
        generation = generation + 1
        for _, token in ipairs(pending) do token.cancelled = true end
        pending = {}
        local complete = true
        for part, record in pairs(touched) do
            if restore(part, record) then touched[part] = nil else complete = false end
        end
        return complete
    end

    local function apply(token)
        if token.applied or token.cancelled or not token.finished then return false end
        if token.generation ~= generation or token.folder ~= folder then token.cancelled = true; return false end
        if token.expires < Clock() then token.cancelled = true; return false end
        if not alive or not Settings.ClientBulletRedirection or not Settings.Enabled then return false end
        if token.character ~= Player.Character then return false end
        local part = token.part
        if not part or part.Parent ~= token.folder then return false end
        local beam = part:FindFirstChild("NewGunBeam")

        if not beam or not beam:IsA("Beam") then return false end
        local endpoint = beam.Attachment1
        local start = beam.Attachment0
        if not endpoint or not start or endpoint.ClassName ~= "Attachment" or start.ClassName ~= "Attachment"
            or endpoint.Parent ~= part or start.Parent ~= part
            or not finiteVector(start.Position) or start.Position.Magnitude > 0.0001 then return false end
        local vector = token.point - token.origin
        local length = vector.Magnitude
        if not finite(length) or length <= 0.001 then return false end
        local record = {
            originalFrame = part.CFrame, originalPosition = endpoint.Position,
            endpoint = endpoint, beam = beam, curve0 = beam.CurveSize0, curve1 = beam.CurveSize1,
            appliedFrame = CFrame.new(token.origin, token.point),
            appliedPosition = Vector3.new(0, 0, -length),
        }
        touched[part] = record
        local ok, problem = pcall(function()
            part.CFrame = record.appliedFrame
            endpoint.Position = record.appliedPosition
            beam.CurveSize0, beam.CurveSize1 = 0, 0
        end)
        if not ok or token.generation ~= generation or token.cancelled then
            local restored = restore(part, record)
            if restored and touched[part] == record then touched[part] = nil end
            if not restored and not touched[part] then touched[part] = record end
            token.cancelled = true
            if not ok then report(problem) end
            return false
        end
        token.applied = true
        return true
    end

    local function onBullet(part)
        if not alive or not Settings.ClientBulletRedirection or not Settings.Enabled then return end
        if part.Parent ~= folder or claimed[part] or part.Name ~= "BULLET_RAYS" or not part:IsA("BasePart") then return end
        local character = Player.Character
        if not character or part:GetAttribute("OwnerCharacter") ~= character.Name then return end
        local now = Clock()

        for _, token in ipairs(pending) do
            if not token.part and not token.cancelled and token.expires >= now
                and token.character == character and token.generation == generation and token.folder == folder then
                local difference = part.CFrame.Position - token.origin
                if difference:Dot(difference) <= 0.0001 then
                    claimed[part] = true
                    token.part = part
                    apply(token)
                    return
                end
            end
        end
    end

    local function bindFolder()
        local ignored = World:FindFirstChild("Ignored")
        local siren = ignored and ignored:FindFirstChild("Siren")
        local current = siren and siren:FindFirstChild("Radius")
        if current ~= folder then
            invalidateRecords()
            if folderConnection then folderConnection:Disconnect(); folderConnection = nil end
            folder = current
            if folder then
                local boundFolder = folder
                folderConnection = ctx.Track(folder.ChildAdded, function(part)
                    if boundFolder ~= folder then return end
                    local ok, problem = pcall(onBullet, part)
                    if not ok then report(problem) end
                end)
            end
        end
        return folder ~= nil
    end

    local adapter = {}

    function adapter:Begin(data, info)
        if not alive or not Settings.Enabled or not Settings.ClientBulletRedirection then return nil end
        if type(data) ~= "table" or type(info) ~= "table" or not info.part or not info.part.Parent then return nil end
        local character = Player.Character
        local handle = data.Handle
        local tool = handle and handle.Parent
        if not character or data.Shooter ~= character or not tool or tool.Parent ~= character
            or data.ReplicatedShot or data.IsLeftHand or data.isReflecting or data.TrailOnly then return nil end
        if not weaponAllowed(tool) or not bindFolder() then return nil end

        if type(ctx.GunHandler.isLegacy) == "function" then
            local ok, legacy = pcall(ctx.GunHandler.isLegacy)
            if ok and legacy then return nil end
        end
        local origin = data.ForcedOrigin
        if typeof(origin) ~= "Vector3" then
            local muzzle = handle:FindFirstChild("Muzzle")
            origin = muzzle and muzzle:IsA("Attachment") and muzzle.WorldPosition or handle.Position
        end
        if not finiteVector(origin) or not finiteVector(info.point)
            or not finiteVector(data.AimPosition) then return nil end

        local aimPoint = finiteVector(info.aimPoint) and info.aimPoint or info.point
        local base = aimPoint - origin
        local shot = data.AimPosition - origin
        if not finite(base.Magnitude) or not finite(shot.Magnitude)
            or base.Magnitude <= 0.001 or shot.Magnitude <= 0.001 then return nil end
        local lead = finite(Settings.VisualPredictionMs) and math.clamp(Settings.VisualPredictionMs, 0, 250) / 1000 or 0
        local velocity = info.part.AssemblyLinearVelocity
        if not finiteVector(velocity) then velocity = Vector3.new(0, 0, 0) end
        local predicted = info.point + velocity * lead - origin
        if not finite(predicted.Magnitude) or predicted.Magnitude <= 0.001 then return nil end

        local visualDirection = rotateDirection(base.Unit, predicted.Unit, shot.Unit)
        local length = predicted.Magnitude
        if finite(data.Range) and data.Range > 0 then length = math.min(length, data.Range) end
        if not finite(length) or not finiteVector(visualDirection) or not finite(visualDirection.Magnitude)
            or visualDirection.Magnitude <= 0.001 then return nil end
        local visualPoint = origin + visualDirection.Unit * length
        if not finiteVector(visualPoint) then return nil end
        local now = Clock()
        for index = #pending, 1, -1 do
            local item = pending[index]
            if item.applied or item.cancelled or item.expires < now then table.remove(pending, index) end
        end
        if #pending >= MAX_PENDING then return nil end
        local token = {
            character = character, origin = origin,
            point = visualPoint, generation = generation, folder = folder,
            expires = now + TTL, finished = false,
        }
        pending[#pending + 1] = token
        return token
    end

    function adapter:Finish(token, success)
        if not token then return end
        if not success then token.cancelled = true; return end
        token.finished = true
        apply(token)
    end

    function adapter:Step()
        if not alive then return end
        if not Settings.ClientBulletRedirection or not Settings.Enabled then
            if #pending > 0 or next(touched) then self:Invalidate() end
            return
        end
        bindFolder()
        local now = Clock()
        for index = #pending, 1, -1 do
            local token = pending[index]
            if not token.cancelled and token.expires >= now then apply(token) end
            if token.applied or token.cancelled or token.expires < now then table.remove(pending, index) end
        end
        for part in pairs(touched) do
            if not part.Parent then touched[part] = nil end
        end
    end

    function adapter:Invalidate()
        return invalidateRecords()
    end

    function adapter:Destroy()
        if not alive and not next(touched) then return true end
        alive = false
        local restored = self:Invalidate()
        if folderConnection then folderConnection:Disconnect(); folderConnection = nil end
        folder = nil
        if not restored then error("Some local tracer properties could not be restored", 0) end
        return true
    end

    return adapter
end

local function buildHitboxController(ctx)
    local Settings, Players, Player = ctx.Settings, ctx.Players, ctx.LocalPlayer
    local World, Clock = ctx.Workspace, ctx.Clock or os.clock
    local records, active, tokens = {}, {}, {}
    local bindings = setmetatable({}, { __mode = "k" })
    local alive, routing, tokenCount, nextScan = true, false, 0, -math.huge
    local diagnostics = { mode = "Waiting for routing", activeParts = 0, expandedParts = 0, errors = 0 }
    local controller = {}
    local bodyNames = { "Head", "UpperTorso", "LowerTorso", "Torso", "LeftUpperArm", "RightUpperArm",
        "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand", "LeftUpperLeg", "RightUpperLeg",
        "LeftLowerLeg", "RightLowerLeg", "LeftFoot", "RightFoot", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

    local function finite(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end
    local function vector(value)
        return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
    end
    local function validSize(value)
        return vector(value) and value.X > 0 and value.Y > 0 and value.Z > 0
    end
    local function dimensions()
        local function axis(name)
            local value = Settings[name]
            return finite(value) and math.clamp(value, 0, 20) or 5
        end
        return axis("HitboxX"), axis("HitboxY"), axis("HitboxZ")
    end
    local function report(problem)
        diagnostics.errors = diagnostics.errors + 1
        diagnostics.lastError = tostring(problem)
        if type(ctx.OnError) == "function" then pcall(ctx.OnError, "hitbox", tostring(problem)) end
    end
    local function attempt(label, callback)
        local ok, result = pcall(callback)
        if not ok then report(label .. ": " .. tostring(result)) end
        return ok, result
    end
    local function validBinding(binding)
        return not binding.invalid and binding.player.Parent == Players and binding.player.Character == binding.character
            and binding.character:IsDescendantOf(World) and binding.native.Parent == binding.character
            and binding.native:IsA("BasePart")
    end
    local function query(record, value)
        if record.destroyed then return not value end
        local ok, matches = attempt("query state", function()
            if record.proxy.CanQuery ~= value then record.proxy.CanQuery = value end
            return record.proxy.CanQuery == value
        end)
        if ok and not matches then report("Query state was overwritten") end
        return ok and matches
    end
    local function hide(record)
        if not record.adornment then return true end
        local ok = attempt("outline cleanup", function() record.adornment:Destroy() end)
        if ok then record.adornment = nil end
        return ok
    end
    local function evacuate(record)
        local ok, result = attempt("effect cleanup", function()
            local children = record.proxy:GetChildren()
            if #children > 64 then error("Proxy has too many foreign children to relocate safely", 0) end
            local destination = validBinding(record.binding) and record.binding.native or nil
            local complete = true
            for _, child in ipairs(children) do
                local moved = attempt("effect relocation", function()
                    if child.Parent == record.proxy then child.Parent = destination end
                    return child.Parent ~= record.proxy
                end)
                if not moved or child.Parent == record.proxy then complete = false end
            end
            return complete
        end)
        return ok and result
    end
    local function disconnect(record)
        local pending = {}
        for _, connection in ipairs(record.connections) do
            if not attempt("lifecycle cleanup", function() connection:Disconnect() end) then
                pending[#pending + 1] = connection
            end
        end
        record.connections = pending
    end
    local function retire(record)
        record.retired, record.queries = true, 0
        if active[record.binding.player] == record then active[record.binding.player] = nil end
        record.queryUnsafe = not query(record, false)
        hide(record)
        if not record.destroyed and evacuate(record) then
            local ok = attempt("proxy cleanup", function() record.proxy:Destroy() end)
            if ok then record.destroyed = true end
        end
        if record.destroyed then record.queryUnsafe = false; disconnect(record) end
        if record.destroyed and not record.adornment and #record.connections == 0 then
            records[record.proxy] = nil
            return true
        end
        return false
    end
    local function retryUnsafeQueries()
        local safe = true
        for _, record in pairs(records) do
            if record.retired and record.queryUnsafe then
                retire(record)
                if record.queryUnsafe then safe = false end
            end
        end
        return safe
    end
    local function releaseAll()
        for token in pairs(tokens) do token.parts = {} end
        tokens, tokenCount = {}, 0
        for _, record in pairs(records) do retire(record) end
        diagnostics.activeParts, diagnostics.expandedParts = 0, 0
        return next(records) == nil
    end
    local function display(record)
        if Settings.HitboxShow == false or not ctx.GuiParent then hide(record); return end
        local ok = attempt("outline", function()
            if record.adornment then
                if record.adornment.Size ~= record.proxy.Size then record.adornment.Size = record.proxy.Size end
                return
            end
            local outline = Instance.new("BoxHandleAdornment")
            record.adornment = outline
            outline.Name = "HitboxOutline"
            outline.Adornee = record.proxy
            outline.CFrame = CFrame.new()
            outline.Size = record.proxy.Size
            outline.Color3 = Color3.fromRGB(235, 235, 235)
            outline.Transparency = 0.91
            outline.AlwaysOnTop = false
            outline.ZIndex = 0
            outline.Visible = true
            outline.Parent = ctx.GuiParent
        end)
        if not ok then hide(record) end
    end
    local function create(binding, size)
        local record
        local ok = attempt("proxy creation", function()
            local proxy = Instance.new("Part")
            record = { proxy = proxy, binding = binding, size = size, queries = 0,
                retired = false, destroyed = false, queryUnsafe = false, connections = {} }
            records[proxy], bindings[proxy] = record, binding
            record.connections[#record.connections + 1] = binding.native.Destroying:Connect(function() binding.invalid = true end)
            record.connections[#record.connections + 1] = binding.character.Destroying:Connect(function() binding.invalid = true end)
            proxy.Name = "DH_HitboxProxy"
            proxy.Shape = Enum.PartType.Block
            proxy.Anchored = true
            proxy.Transparency = 1
            proxy.CanCollide = false
            proxy.CanTouch = false
            proxy.CanQuery = false
            proxy.CastShadow = false
            proxy.Size = size
            proxy.CFrame = binding.native.CFrame
            proxy.Parent = binding.character
            record.size = proxy.Size
            active[binding.player] = record
        end)
        if not ok then
            if record then retire(record) end
            return nil, record ~= nil and records[record.proxy] ~= nil
        end
        display(record)
        return record, true
    end
    local function root(character)
        local part = character and character:FindFirstChild("HumanoidRootPart")
        return part and part:IsA("BasePart") and part or nil
    end
    local function eligible(player, origin)
        if player == Player or player.Parent ~= Players then return nil end
        local character = player.Character
        if not character or not character:IsDescendantOf(World) then return nil end
        if Settings.TeamCheck and Player.Team ~= nil and not Player.Neutral
            and not player.Neutral and player.Team == Player.Team then return nil end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or not finite(humanoid.Health) or humanoid.Health <= 0 then return nil end
        local effects = character:FindFirstChild("BodyEffects")
        local dead = effects and effects:FindFirstChild("Dead")
        if dead and dead.Value == true then return nil end
        local knocked = effects and effects:FindFirstChild("K.O")
        if Settings.SkipKnocked and knocked and knocked.Value == true then return nil end
        local part = root(character)
        if not part then return nil end
        local delta = part.Position - origin
        local distance = delta:Dot(delta)
        if not finite(distance) or distance > 220 * 220 then return nil end
        return character, distance
    end
    local function scan()
        for _, record in pairs(records) do if record.retired then retire(record) end end
        local origin = root(Player.Character)
        if not origin then releaseAll(); diagnostics.mode = "Waiting for character"; return end
        local candidates = {}
        for index, player in ipairs(Players:GetPlayers()) do
            local character, distance = eligible(player, origin.Position)
            if character then candidates[#candidates + 1] = { player = player, character = character,
                distance = distance, order = index } end
        end
        table.sort(candidates, function(a, b)
            if a.distance ~= b.distance then return a.distance < b.distance end
            local ai, bi = a.player.UserId or 0, b.player.UserId or 0
            return ai < bi or (ai == bi and a.order < b.order)
        end)
        local selected, order = {}, {}
        local x, y, z = dimensions()
        for _, candidate in ipairs(candidates) do
            local part = root(candidate.character)
            local size = part and part.Size
            if validSize(size) and size.X <= 20 and size.Y <= 20 and size.Z <= 20 then
                selected[candidate.player] = { player = candidate.player, character = candidate.character, native = part,
                    size = Vector3.new(math.max(size.X, x), math.max(size.Y, y), math.max(size.Z, z)) }
                order[#order + 1] = candidate.player
                if #order >= 128 then break end
            end
        end
        for player, record in pairs(active) do
            local choice = selected[player]
            if not choice or choice.native ~= record.binding.native or choice.character ~= record.binding.character then retire(record) end
        end
        local count = 0
        for _ in pairs(records) do count = count + 1 end
        for _, player in ipairs(order) do
            local choice, record = selected[player], active[player]
            if not record and count < 128 then
                local binding = { player = player, character = choice.character, native = choice.native, invalid = false }
                local tracked
                record, tracked = create(binding, choice.size)
                if tracked then count = count + 1 end
            elseif record then
                if record.proxy.Size ~= choice.size then record.proxy.Size = choice.size end
                record.size = record.proxy.Size
                display(record)
            end
        end
        diagnostics.mode = "Enabled"
    end
    local function follow(record)
        if not validBinding(record.binding) or record.proxy.Parent ~= record.binding.character then retire(record); return end
        local frame = record.binding.native.CFrame
        if record.proxy.CFrame ~= frame then record.proxy.CFrame = frame end
        if record.queries == 0 and not query(record, false) then retire(record) end
    end
    function controller:Step()
        if not alive then return true end
        local ok, problem = pcall(function()
            local now, x, y, z = Clock(), dimensions()
            if not Settings.HitboxEnabled or not routing or x <= 0 or y <= 0 or z <= 0 then
                if next(active) ~= nil or tokenCount > 0 or now >= nextScan then
                    releaseAll(); nextScan = now + 0.2
                end
                diagnostics.mode = not routing and "Waiting for routing" or not Settings.HitboxEnabled and "Disabled" or "Zero size"
                return
            end
            if now >= nextScan or nextScan - now >= 1 then scan(); nextScan = now + 0.2 end
            for _, record in pairs(active) do follow(record) end
            local count = 0
            for _ in pairs(active) do count = count + 1 end
            diagnostics.activeParts, diagnostics.expandedParts = count, count
        end)
        if not ok then report(problem); releaseAll(); diagnostics.mode = "Error" end
        return ok
    end
    function controller:Refresh()
        nextScan = -math.huge
        return self:Step()
    end
    function controller:Invalidate()
        local clean = releaseAll()
        nextScan = -math.huge
        diagnostics.mode = "Reset"
        return clean
    end
    function controller:SetRoutingReady(value)
        routing = value == true and alive
        if not routing then return self:Invalidate() end
        return self:Refresh()
    end
    local function shotRay(data)
        if type(data) ~= "table" or not vector(data.AimPosition) then return nil end
        local origin = data.ForcedOrigin
        if not vector(origin) then
            local handle = data.Handle
            if not handle then return nil end
            local muzzle = handle:FindFirstChild("Muzzle")
            origin = muzzle and muzzle:IsA("Attachment") and muzzle.WorldPosition or handle.Position
        end
        if not vector(origin) then return nil end
        local delta, range = data.AimPosition - origin, data.Range == nil and 200 or data.Range
        if not vector(delta) or not finite(delta.Magnitude) or delta.Magnitude <= 0.0001
            or not finite(range) or range <= 0 then return nil end
        return { Origin = origin, Direction = delta.Unit, Range = range }
    end
    local function intersect(ray, frame, size)
        local o, d, h = frame:PointToObjectSpace(ray.Origin), frame:VectorToObjectSpace(ray.Direction), size * 0.5
        local origins, directions, halves = { o.X, o.Y, o.Z }, { d.X, d.Y, d.Z }, { h.X, h.Y, h.Z }
        local enter, leave = 0, ray.Range
        for axis = 1, 3 do
            local position, direction, half = origins[axis], directions[axis], halves[axis]
            if math.abs(direction) < 0.000000001 then
                if position < -half or position > half then return nil end
            else
                local first, last = (-half - position) / direction, (half - position) / direction
                if first > last then first, last = last, first end
                enter, leave = math.max(enter, first), math.min(leave, last)
                if leave < enter then return nil end
            end
        end
        return enter
    end
    local function beginScope(makeRay, existingOnly)
        if not retryUnsafeQueries() then error("Hitbox query cleanup failed; shot cancelled", 0) end
        if not alive or not routing or not Settings.HitboxEnabled then return nil end
        local token
        local ok, result = pcall(function()
            local x, y, z = dimensions()
            if x <= 0 or y <= 0 or z <= 0 then return nil end
            local ray = makeRay()
            if not ray or tokenCount >= 32 then return nil end
            if existingOnly then
                for _, record in pairs(active) do follow(record) end
            elseif controller:Step() == false then return nil end
            local matches = {}
            for _, record in pairs(active) do
                if not record.retired and validBinding(record.binding)
                    and (ray == true or intersect(ray, record.proxy.CFrame, record.proxy.Size) ~= nil) then
                    matches[#matches + 1] = record
                end
            end
            if #matches == 0 then return nil end
            token = { parts = {}, ray = ray }
            tokens[token], tokenCount = true, tokenCount + 1
            for _, record in ipairs(matches) do
                token.parts[#token.parts + 1] = record
                record.queries = record.queries + 1
                if not query(record, true) then error("Could not enable a scoped hitbox query", 0) end
            end
            return token
        end)
        if not ok then
            local clean = not token or controller:EndShot(token)
            report(result)
            if not clean or not retryUnsafeQueries() then error("Hitbox query cleanup failed; shot cancelled", 0) end
            return nil
        end
        if not retryUnsafeQueries() then
            if token then controller:EndShot(token) end
            error("Hitbox query cleanup failed; shot cancelled", 0)
        end
        return result
    end
    function controller:BeginShot(data)
        return beginScope(function()
            if type(data) ~= "table" or data.Shooter ~= Player.Character or data.Hit ~= nil
                or data.ReplicatedShot or data.isReflecting or data.TrailOnly then return nil end
            local handle = data.Handle
            if not handle or not handle.Parent or handle.Parent.Parent ~= Player.Character then return nil end
            return shotRay(data)
        end, false)
    end
    function controller:BeginAim(origin, requestedRange, allowQueries)
        return beginScope(function()
            if allowQueries == false or not vector(origin) then return nil end
            local range = requestedRange == nil and 200 or requestedRange
            if not finite(range) or range <= 0 then return nil end
            return true
        end, true)
    end
    function controller:EndShot(token)
        if not tokens[token] then return true end
        tokens[token], tokenCount = nil, math.max(0, tokenCount - 1)
        local clean = true
        for _, record in ipairs(token.parts) do
            if not record.retired then
                record.queries = math.max(0, record.queries - 1)
                if record.queries == 0 and not query(record, false) then
                    if not retire(record) then clean = false end
                end
            end
        end
        token.parts = {}
        return clean
    end
    function controller:EndAim(token)
        return self:EndShot(token)
    end
    local function clampPoint(frame, size, point)
        local localPoint, half = frame:PointToObjectSpace(point), size * 0.5
        return frame:PointToWorldSpace(Vector3.new(math.clamp(localPoint.X, -half.X, half.X),
            math.clamp(localPoint.Y, -half.Y, half.Y), math.clamp(localPoint.Z, -half.Z, half.Z)))
    end
    function controller:ResolveHit(hit, position, data)
        local binding = bindings[hit]
        if not binding then return false, hit end
        local ok, result = pcall(function()
            if not validBinding(binding) then return nil end
            local ray = shotRay(data)
            local first, firstDistance, closest, closestDistance
            for _, name in ipairs(bodyNames) do
                local part = binding.character:FindFirstChild(name)
                if part and part:IsA("BasePart") and validSize(part.Size) then
                    local frame, size = part.CFrame, part.Size
                    local entry = ray and intersect(ray, frame, size)
                    if entry ~= nil and (firstDistance == nil or entry < firstDistance) then
                        first, firstDistance = part, entry
                    end
                    if Settings.HitboxTarget == "NearestPart" then
                        local point, reference
                        if ray and type(ctx.ClosestRayBoxPoint) == "function" then
                            point = frame:PointToWorldSpace(ctx.ClosestRayBoxPoint(frame, size, ray))
                            local t = math.clamp((point - ray.Origin):Dot(ray.Direction), 0, ray.Range)
                            reference = ray.Origin + ray.Direction * t
                            if t <= 0 or t >= ray.Range then point = clampPoint(frame, size, reference) end
                        else
                            reference = vector(position) and position or ray and ray.Origin + ray.Direction * ray.Range or binding.native.Position
                            point = clampPoint(frame, size, reference)
                        end
                        local delta = point - reference
                        local distance = delta:Dot(delta)
                        if finite(distance) and (closestDistance == nil or distance < closestDistance) then
                            closest, closestDistance = part, distance
                        end
                    end
                end
            end
            return first or closest or binding.native
        end)
        if not ok then report("hit mapping: " .. tostring(result)); return true, nil end
        return true, result
    end
    function controller:GetNativeSize(proxy)
        if not alive or not routing or not Settings.HitboxEnabled then return nil end
        local x, y, z = dimensions()
        if x <= 0 or y <= 0 or z <= 0 then return nil end
        local record = records[proxy]
        if not record or record.retired or record.destroyed then return nil end
        local ok, size = pcall(function()
            if not validBinding(record.binding) or proxy.Parent ~= record.binding.character then return nil end
            return record.binding.native.Size
        end)
        if ok and validSize(size) then return size end
        return nil
    end
    function controller:GetOriginalPart(proxy)
        local binding = bindings[proxy]
        if not binding then return nil end
        local ok, part = pcall(function() return validBinding(binding) and binding.native or nil end)
        return ok and part or nil
    end
    function controller:GetExpandedParts()
        local parts = {}
        for _, record in pairs(active) do
            if self:GetNativeSize(record.proxy) then parts[#parts + 1] = record.proxy end
            if #parts >= 128 then break end
        end
        return parts
    end
    function controller:GetDiagnostics()
        local result, pending, unsafe = {}, 0, 0
        for key, value in pairs(diagnostics) do result[key] = value end
        for _, record in pairs(records) do
            if record.retired then pending = pending + 1 end
            if record.queryUnsafe then unsafe = unsafe + 1 end
        end
        result.pendingRestore, result.activeShots, result.routingReady = pending, tokenCount, routing
        result.unsafeQueries = unsafe
        return result
    end
    function controller:Destroy()
        alive, routing = false, false
        local clean = releaseAll()
        if not clean then clean = releaseAll() end
        if not clean then report("One or more owned hitbox artifacts could not be removed") end
        diagnostics.mode = "Destroyed"
        return clean
    end
    return controller
end

local function buildParticleSpoofer(ctx)
    local Settings, Hitbox, World = ctx.Settings, ctx.Hitbox, ctx.Workspace
    local Clock = ctx.Clock or os.clock
    local roots, emitters = {}, {}
    local externallyMoved = setmetatable({}, {__mode = "k"})
    local rootCount, emitterCount, alive, nextUpdate = 0, 0, true, -math.huge
    local folder = nil
    local ROOT_LIMIT, EMITTER_LIMIT = 64, 256
    local diagnostics = {mode = "Disabled", errors = 0, lastError = "", activeCarriers = 0, movedEmitters = 0, pendingRestore = 0}
    local controller = {}

    local function report(problem)
        diagnostics.errors = diagnostics.errors + 1
        diagnostics.lastError = tostring(problem)
        if type(ctx.OnError) == "function" then pcall(ctx.OnError, "particle_spoofer", tostring(problem)) end
    end
    local function read(object, property)
        local ok, value = pcall(function() return object[property] end)
        return ok, value
    end
    local function children(object)
        local ok, value = pcall(function() return object:GetChildren() end)
        if not ok then report("children: " .. tostring(value)); return false, {} end
        return true, value
    end
    local function isA(object, class)
        local ok, value = pcall(function() return object:IsA(class) end)
        return ok and value == true
    end
    local function validSize(value)
        if typeof(value) ~= "Vector3" then return false end
        for _, axis in ipairs({value.X, value.Y, value.Z}) do
            if type(axis) ~= "number" or axis ~= axis or axis <= 0 or axis == math.huge then return false end
        end
        return true
    end
    local function enabled()
        return alive and Settings.HitboxEnabled == true
    end
    local function nativeSize(root)
        if not enabled() or not isA(root, "BasePart") then return nil end
        local ok, value = pcall(Hitbox.GetNativeSize, Hitbox, root)
        if ok and validSize(value) then return value end
        return nil
    end
    local function disconnect(list)
        local remaining = {}
        for _, connection in ipairs(list) do
            local ok, problem = pcall(function() connection:Disconnect() end)
            if not ok then remaining[#remaining + 1] = connection; report("disconnect: " .. tostring(problem)) end
        end
        return remaining
    end
    local function rootUsable(record)
        if record.rootDestroyed then return false end
        local ok, value = pcall(function() return record.root.Parent ~= nil and record.root:IsDescendantOf(World) end)
        return ok and value == true
    end
    local function restoreDestination(record)
        if rootUsable(record.owner) then
            local ok, size = pcall(Hitbox.GetNativeSize, Hitbox, record.originalParent)
            if ok and validSize(size) then return record.originalParent end
        end
        if type(Hitbox.GetOriginalPart) == "function" then
            local ok, original = pcall(Hitbox.GetOriginalPart, Hitbox, record.originalParent)
            if ok and isA(original, "BasePart") then
                local valid, inWorld = pcall(function() return original.Parent ~= nil and original:IsDescendantOf(World) end)
                if valid and inWorld then return original end
            end
        end
        return nil
    end
    local function setParent(record, parent)
        record.moving = true
        local ok, problem = pcall(function() record.emitter.Parent = parent end)
        record.moving = false
        if not ok then report("emitter parent: " .. tostring(problem)) end
        local readOK, actual = read(record.emitter, "Parent")
        if not readOK then report("emitter parent read: " .. tostring(actual)) end
        return readOK, actual
    end
    local function releaseEmitter(record)
        record.releasing = true
        record.connections = disconnect(record.connections)
        local ok, current = read(record.emitter, "Parent")
        if not ok then report("emitter restore read: " .. tostring(current)); return false end
        if current == record.carrier then
            local destination = restoreDestination(record)
            ok, current = setParent(record, destination)
            if not ok or current == record.carrier then return false end
        end
        if #record.connections > 0 then return false end
        if emitters[record.emitter] == record then
            emitters[record.emitter] = nil
            record.owner.emitters[record.emitter] = nil
            emitterCount = emitterCount - 1
        end
        return true
    end
    local function cleanupFolder()
        if not folder or next(roots) ~= nil then return folder == nil end
        local ok, contents = children(folder)
        if not ok or #contents > 0 then return false end
        local success, problem = pcall(function() folder:Destroy() end)
        if success then folder = nil else report("folder cleanup: " .. tostring(problem)) end
        return folder == nil
    end
    local function releaseRoot(record)
        record.releasing = true
        record.connections = disconnect(record.connections)
        for _, emitter in pairs(record.emitters) do releaseEmitter(emitter) end
        if next(record.emitters) ~= nil or #record.connections > 0 then return false end
        if record.carrier then
            local ok, contents = children(record.carrier)
            if not ok or #contents > 0 then return false end
            local success, problem = pcall(function() record.carrier:Destroy() end)
            if not success then report("carrier cleanup: " .. tostring(problem)); return false end
            record.carrier = nil
        end
        if roots[record.root] == record then roots[record.root] = nil; rootCount = rootCount - 1 end
        return true
    end
    local function releaseAll()
        for _, record in pairs(roots) do releaseRoot(record) end
        cleanupFolder()
        return next(roots) == nil and next(emitters) == nil and folder == nil
    end
    local function ensureFolder()
        if folder then
            local ok, parent = read(folder, "Parent")
            return ok and parent == World
        end
        local ok, result = pcall(function()
            local created = Instance.new("Folder")
            folder = created
            created.Name = "DH_ParticleBounds"
            created.Parent = World
            return created
        end)
        if not ok then report("folder creation: " .. tostring(result)); cleanupFolder(); return false end
        return result ~= nil
    end
    local function syncCarrier(record, size)
        local carrier = record.carrier
        if not carrier then return true end
        local ok, problem = pcall(function()
            if carrier.Parent ~= folder or folder.Parent ~= World then error("Particle carrier was moved") end
            if carrier.Size ~= size then carrier.Size = size end
            local frame = record.root.CFrame
            if carrier.CFrame ~= frame then carrier.CFrame = frame end
        end)
        if not ok then report("carrier update: " .. tostring(problem)) end
        return ok
    end
    local function ensureCarrier(record, size)
        if record.carrier then return syncCarrier(record, size) end
        if not ensureFolder() then releaseRoot(record); cleanupFolder(); return false end
        local ok, problem = pcall(function()
            local carrier = Instance.new("Part")
            record.carrier = carrier
            carrier.Name = "NativeParticleBounds"
            carrier.Anchored = true
            carrier.Transparency = 1
            carrier.CastShadow = false
            carrier.CanCollide = false
            carrier.CanQuery = false
            carrier.CanTouch = false
            carrier.Size = size
            carrier.CFrame = record.root.CFrame
            carrier.Parent = folder
        end)
        if not ok then report("carrier creation: " .. tostring(problem)); releaseRoot(record); return false end
        return true
    end
    local function eligible(record)
        return enabled() and roots[record.root] == record and not record.releasing and not record.rootDestroyed
    end
    local function attachEmitter(record, emitter)
        if not eligible(record) or record.ignored[emitter] or externallyMoved[emitter] or emitters[emitter] or emitterCount >= EMITTER_LIMIT
            or not isA(emitter, "ParticleEmitter") then return end
        local parentOK, parent = read(emitter, "Parent")
        if not parentOK or parent ~= record.root then return end
        local size = nativeSize(record.root)
        if not size or not ensureCarrier(record, size) or not eligible(record) then return end
        local entry = {
            emitter = emitter, owner = record, originalParent = record.root, carrier = record.carrier,
            moving = false, releasing = false, connections = {},
        }
        emitters[emitter], record.emitters[emitter] = entry, entry
        emitterCount = emitterCount + 1
        local connected, connection = pcall(function()
            return emitter:GetPropertyChangedSignal("Parent"):Connect(function()
                if not alive or entry.releasing or entry.moving or emitters[emitter] ~= entry then return end
                local ok, current = read(emitter, "Parent")
                if ok and current ~= entry.carrier then
                    record.ignored[emitter] = true
                    externallyMoved[emitter] = true
                    releaseEmitter(entry)
                end
            end)
        end)
        if not connected then
            report("emitter observer: " .. tostring(connection))
            record.ignored[emitter] = true
            releaseEmitter(entry)
            return
        end
        entry.connections[#entry.connections + 1] = connection
        local ok, current = setParent(entry, entry.carrier)
        if not ok or current ~= entry.carrier then
            record.ignored[emitter] = true
            if ok then externallyMoved[emitter] = true end
            releaseEmitter(entry)
        end
    end
    local function newRoot(root)
        if rootCount >= ROOT_LIMIT then return nil end
        local record = {
            root = root, rootDestroyed = false, releasing = false, carrier = nil,
            connections = {}, emitters = {}, ignored = setmetatable({}, {__mode = "k"}),
        }
        roots[root], rootCount = record, rootCount + 1
        local ok, problem = pcall(function()
            record.connections[#record.connections + 1] = root.ChildAdded:Connect(function(child)
                if eligible(record) then attachEmitter(record, child) end
            end)
            record.connections[#record.connections + 1] = root.Destroying:Connect(function()
                if roots[root] ~= record then return end
                record.rootDestroyed = true
                releaseRoot(record)
            end)
        end)
        if not ok then report("root observer: " .. tostring(problem)); releaseRoot(record); return nil end
        return record
    end
    local function refreshRoots()
        local ok, parts = pcall(Hitbox.GetExpandedParts, Hitbox)
        if not ok or type(parts) ~= "table" then
            report("Expanded roots were unavailable")
            releaseAll()
            return
        end
        local selected, order = {}, {}
        for index, root in ipairs(parts) do
            if index > ROOT_LIMIT then break end
            local size = nativeSize(root)
            if size and not selected[root] then selected[root] = size; order[#order + 1] = root end
        end
        for root, record in pairs(roots) do
            if record.releasing or not selected[root] then releaseRoot(record) end
        end
        for _, root in ipairs(order) do
            local record = roots[root]
            if not record then record = newRoot(root) end
            if record and not record.releasing then
                for emitter, entry in pairs(record.emitters) do
                    local readOK, parent = read(emitter, "Parent")
                    if entry.releasing or (readOK and parent ~= entry.carrier) then
                        record.ignored[emitter] = true
                        if readOK and parent ~= entry.carrier then externallyMoved[emitter] = true end
                        releaseEmitter(entry)
                    end
                end
                local readOK, contents = children(root)
                if readOK then
                    for index, child in ipairs(contents) do
                        if index > 128 then break end
                        attachEmitter(record, child)
                    end
                end
            end
        end
    end
    function controller:Step()
        if not alive then return end
        local now = Clock()
        local refresh = not (now < nextUpdate and nextUpdate - now < 1)
        if not enabled() then
            for _, record in pairs(roots) do
                if not record.releasing or refresh then releaseRoot(record) end
            end
            if refresh then
                cleanupFolder()
                if next(roots) == nil and next(emitters) == nil then externallyMoved = setmetatable({}, {__mode = "k"}) end
                nextUpdate = now + 0.2
            end
            diagnostics.mode = (next(roots) ~= nil or folder ~= nil) and "Restoring" or "Disabled"
            return
        end
        for _, record in pairs(roots) do
            if not record.releasing and record.carrier and next(record.emitters) ~= nil then
                local size = nativeSize(record.root)
                if not size or not syncCarrier(record, size) then releaseRoot(record) end
            end
        end
        if refresh then nextUpdate = now + 0.2; refreshRoots() end
        diagnostics.mode = "Enabled"
    end
    function controller:Refresh()
        nextUpdate = -math.huge
        self:Step()
    end
    function controller:Invalidate()
        if releaseAll() then externallyMoved = setmetatable({}, {__mode = "k"}) end
        nextUpdate = -math.huge
        diagnostics.mode = "Reset"
    end
    function controller:GetDiagnostics()
        local result = {}
        for key, value in pairs(diagnostics) do result[key] = value end
        result.activeCarriers, result.movedEmitters, result.pendingRestore = 0, 0, 0
        for _, record in pairs(roots) do
            if record.releasing then result.pendingRestore = result.pendingRestore + 1
            elseif record.carrier then result.activeCarriers = result.activeCarriers + 1 end
        end
        for _, entry in pairs(emitters) do
            if entry.releasing then result.pendingRestore = result.pendingRestore + 1
            else result.movedEmitters = result.movedEmitters + 1 end
        end
        if folder and next(roots) == nil then result.pendingRestore = result.pendingRestore + 1 end
        result.trackedRoots = rootCount
        result.rootLimit, result.emitterLimit = ROOT_LIMIT, EMITTER_LIMIT
        return result
    end
    function controller:Destroy()
        alive = false
        local restored = releaseAll()
        diagnostics.mode = restored and "Destroyed" or "Restoring"
        return restored
    end
    return controller
end

local function buildMovementController(ctx)
    local Settings, Player = ctx.Settings, ctx.LocalPlayer
    local Clock = ctx.Clock or os.clock
    local alive = true
    local owned
    local updating, releasing, refreshRequested = false, false, false
    local runUpdate, queueCorrection
    local controller = {}
    local MAX_CORRECTIONS = 8
    local NATIVE_SETTLE_TIME = 0.12
    local stepNumber = 0
    local diagnostic = {enabled = false, mode = "Disabled", multiplier = 1}

    local function finite(value)
        return type(value) == "number" and value == value and math.abs(value) < math.huge
    end

    local function sameStoredSpeed(a, b)

        return finite(a) and finite(b)
            and math.abs(a - b) <= math.max(1, math.abs(a), math.abs(b)) * 0.0000001
    end

    local function release()
        if not owned or releasing then return end
        local record = owned
        releasing = true
        local ok, failure = pcall(function()

            record.active = false
            record.generation = record.generation + 1
            record.queued, record.forceQueued = false, false
            if record.connection then
                record.connection:Disconnect()
                record.connection = nil
            end

            if record.humanoid.Parent then
                local current = record.humanoid.WalkSpeed
                local inFlight = record.inFlight ~= nil and sameStoredSpeed(current, record.inFlight)
                if (record.applied ~= nil and current == record.applied) or inFlight then
                    record.humanoid.WalkSpeed = record.restoreNative
                end
            end
        end)
        releasing = false
        if not ok then error(failure, 0) end
        if owned == record then owned = nil end
    end

    local function report(problem)
        if type(ctx.OnError) == "function" then pcall(ctx.OnError, "movement", problem) end
    end

    local function liveRecord(record)
        return alive and Settings.MovementEnabled and owned == record and record.active
            and Player.Character == record.character and record.humanoid.Parent == record.character
    end

    local function correct(record, force)
        if not liveRecord(record) then return end
        if not force and (record.factor == 1 or (record.applied ~= nil
            and sameStoredSpeed(record.humanoid.WalkSpeed, record.applied))) then return end
        if record.remaining <= 0 then record.conflicted = true; return end
        record.remaining = record.remaining - 1
        local ok, failure = pcall(runUpdate)
        if not ok then
            local released, cleanupFailure = pcall(controller.Invalidate, controller)
            report(tostring(failure) .. (released and "" or " | " .. tostring(cleanupFailure)))
        end
    end

    queueCorrection = function(record, force)
        if not liveRecord(record) then return end
        if record.queued then
            record.forceQueued = record.forceQueued or force == true
            return
        end
        if record.remaining <= 0 then record.conflicted = true; return end
        record.queued, record.forceQueued = true, force == true
        local generation = record.generation
        task.defer(function()
            if generation ~= record.generation or not liveRecord(record) then return end
            local forced = record.forceQueued
            record.queued, record.forceQueued = false, false
            correct(record, forced)
        end)
    end

    local function bindObserver(record)
        record.connection = record.humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()

            if updating or not liveRecord(record) or record.factor == 1 then return end
            if record.applied ~= nil and sameStoredSpeed(record.humanoid.WalkSpeed, record.applied) then return end
            correct(record, false)
        end)
    end

    local function flag(container, name)
        local value = container and container:FindFirstChild(name)
        return value ~= nil and value:IsA("BoolValue") and value.Value == true
    end

    local function eligible(character, humanoid, effects)
        if not character or not character.Parent or not humanoid or not humanoid.Parent then
            return false, "Waiting"
        end
        if not finite(humanoid.Health) or humanoid.Health <= 0
            or flag(effects, "Dead") or flag(effects, "K.O")
            or flag(effects, "Cuff") or flag(effects, "Grabbed") then
            return false, "Paused"
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then return false, "Waiting" end
        local state = humanoid:GetState()
        if root.Anchored or humanoid.Sit or humanoid.PlatformStand
            or state == Enum.HumanoidStateType.Dead
            or state == Enum.HumanoidStateType.Seated
            or state == Enum.HumanoidStateType.PlatformStanding
            or state == Enum.HumanoidStateType.Physics
            or state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.FallingDown then
            return false, "Paused"
        end
        return true
    end

    local function isShooting(character, now)
        local tool = character:FindFirstChildWhichIsA("Tool")
        if not tool or not tool:FindFirstChild("Handle") then return false end
        local cooldownValue = tool:FindFirstChild("ShootingCooldown")
        local cooldown = cooldownValue and cooldownValue:IsA("ValueBase") and cooldownValue.Value
        if not finite(cooldown) then return false end

        local duration = math.clamp(cooldown, 0.1, 1)
        local last = tool:GetAttribute("LocalLastShotAt")
        if character:GetAttribute("LocalLastFiredGun") == tool.Name then
            local stamp = character:GetAttribute("LocalLastGunShotAt")
            if finite(stamp) and (not finite(last) or stamp > last) then last = stamp end
        end
        return finite(last) and now >= last and now - last < duration
    end

    local function chooseMode(character, humanoid, effects, now)
        if flag(effects, "Reload") then return "Reloading", "ReloadMultiplier" end
        if isShooting(character, now) then return "Shooting", "ShootMultiplier" end
        local maximum = humanoid.MaxHealth
        local threshold = Settings.LowHealthThreshold
        if not finite(threshold) then threshold = 50 end
        if finite(maximum) and maximum > 0
            and humanoid.Health / maximum <= math.clamp(threshold, 1, 100) / 100 then
            return "Low health", "LowHealthMultiplier"
        end
        return "Walking", "WalkMultiplier"
    end

    local function refreshNative(record, mode, current, multiplier, now)
        local ours = record.applied ~= nil and sameStoredSpeed(current, record.applied)
        if not ours then record.restoreNative = current end
        if mode ~= record.mode then
            local previousNative = record.native
            local previousStable = record.nativeByMode[record.mode]
            local incoming = record.nativeByMode[mode]
            local fresh
            if not ours and not sameStoredSpeed(current, previousNative) then fresh = current
            elseif previousStable ~= nil and not sameStoredSpeed(previousNative, previousStable) then
                fresh = previousNative
            end
            record.mode, record.modeSince = mode, now
            record.transitionNative, record.transitionUntil = previousNative, now + NATIVE_SETTLE_TIME
            if fresh ~= nil then
                record.native, record.waitStep = fresh, 0
                if incoming == nil then record.nativeByMode[mode] = fresh end
            elseif incoming ~= nil then
                record.native, record.waitStep = incoming, 0
            else
                record.waitNative, record.waitStep = previousNative, stepNumber + 1
            end
            if multiplier == 1 and not ours then record.native, record.waitStep = current, 0 end
            if not ours then record.applied = nil end
            record.candidateNative, record.candidateAt = record.native, now
        elseif not ours then
            local returning = record.nativeByMode[mode]
            local staleTransition = multiplier ~= 1 and now < record.transitionUntil
                and returning ~= nil and not sameStoredSpeed(current, returning)
                and sameStoredSpeed(current, record.transitionNative)
            if not staleTransition then
                record.native, record.applied = current, nil
                if record.waitStep > 0 and not sameStoredSpeed(current, record.waitNative) then
                    record.waitStep = 0
                end
            end
        end
        if record.waitStep > 0 and stepNumber >= record.waitStep then record.waitStep = 0 end
        if not sameStoredSpeed(record.native, record.candidateNative) then
            record.candidateNative, record.candidateAt = record.native, now
        end
        if record.waitStep == 0 and (record.nativeByMode[mode] == nil
            or (now - record.candidateAt >= NATIVE_SETTLE_TIME and now - record.modeSince >= NATIVE_SETTLE_TIME)) then
            record.nativeByMode[mode] = record.native
        end
    end

    local function update()
        if not alive then return end
        if not Settings.MovementEnabled then
            release()
            diagnostic = {enabled = false, mode = "Disabled", multiplier = 1}
            return
        end
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local effects = character and character:FindFirstChild("BodyEffects")
        if owned and (owned.humanoid ~= humanoid or not owned.active) then release() end
        local usable, reason = eligible(character, humanoid, effects)
        if not usable then
            release()
            diagnostic = {enabled = true, mode = reason, multiplier = 1}
            return
        end
        local current = humanoid.WalkSpeed
        if not finite(current) or current < 0 then
            release()
            diagnostic = {enabled = true, mode = "Invalid speed", multiplier = 1}
            return
        end
        local now = Clock()
        local mode, setting = chooseMode(character, humanoid, effects, now)
        local multiplier = Settings[setting]
        if not finite(multiplier) then multiplier = 1 end
        multiplier = math.clamp(multiplier, 0.25, 3)
        if not owned then
            owned = {
                humanoid = humanoid, character = character, native = current, restoreNative = current,
                active = true, generation = 1, remaining = MAX_CORRECTIONS,
                factor = 1, queued = false, forceQueued = false, conflicted = false,
                mode = mode, modeSince = now, nativeByMode = {[mode] = current},
                candidateNative = current, candidateAt = now,
                transitionNative = current, transitionUntil = 0, waitNative = current, waitStep = 0,
            }
            bindObserver(owned)
        end
        local record = owned
        refreshNative(record, mode, current, multiplier, now)
        record.factor = multiplier
        local target = owned.native * (record.waitStep > 0 and 1 or multiplier)
        if not finite(target) then
            release()
            diagnostic = {enabled = true, mode = "Invalid speed", multiplier = 1}
            return
        end

        if not sameStoredSpeed(current, target) then
            local previousApplied = owned.applied
            record.inFlight = target
            local ok, failure = pcall(function() humanoid.WalkSpeed = target end)
            current = humanoid.WalkSpeed

            if not liveRecord(record) then
                if owned == record then release() end
                record.inFlight = nil
                return
            end
            record.inFlight = nil
            if not ok then
                owned.applied = sameStoredSpeed(current, target) and current or previousApplied
                error(failure, 0)
            end
        end
        if sameStoredSpeed(current, target) then

            owned.applied = target ~= owned.native and current or nil
        else

            owned.applied = nil
            if finite(current) and current >= 0 then owned.native, owned.restoreNative = current, current end
            record.conflicted = true
            queueCorrection(record, false)
        end
        diagnostic = {
            enabled = true, mode = mode, multiplier = multiplier,
            nativeSpeed = owned.native, appliedSpeed = humanoid.WalkSpeed,
        }
    end

    runUpdate = function()
        if not alive then return end
        if updating or releasing then refreshRequested = true; return end
        updating, refreshRequested = true, false
        local ok, failure = pcall(update)
        updating = false
        if not ok then refreshRequested = false; error(failure, 0) end
        if refreshRequested then
            refreshRequested = false
            if owned then queueCorrection(owned, true) end
        end
    end

    function controller:Step()
        if not alive then return end
        if updating or releasing then refreshRequested = true; return end
        if not Settings.MovementEnabled and not owned and diagnostic.mode == "Disabled" then return end

        stepNumber = stepNumber + 1
        if owned then owned.remaining, owned.conflicted = MAX_CORRECTIONS, false end
        runUpdate()
    end

    function controller:Refresh()
        runUpdate()
    end

    function controller:Invalidate()
        release()
        diagnostic = {enabled = Settings.MovementEnabled == true, mode = "Waiting", multiplier = 1}
    end

    function controller:GetDiagnostics()
        local copy = {}
        for key, value in pairs(diagnostic) do copy[key] = value end
        copy.observerConnected = owned ~= nil and owned.connection ~= nil
            and owned.connection.Connected == true
        copy.pendingCorrection = owned ~= nil and owned.queued == true
        copy.correctionsThisStep = owned and (MAX_CORRECTIONS - owned.remaining) or 0
        copy.conflicted = owned ~= nil and owned.conflicted == true
        return copy
    end

    function controller:Destroy()
        alive = false
        release()
        diagnostic = {enabled = false, mode = "Unloaded", multiplier = 1}
    end

    return controller
end

local function buildConfigController(ctx)
    local files = ctx.FileOps or {}
    local defaults, entries, names = {}, {}, {}
    for key, value in pairs(ctx.Defaults or {}) do defaults[key] = value end
    local folder, metaPath = "DmcDaHood/Configs", "DmcDaHood/autoload.json"
    local alive, busy, initialized, available = true, false, false, false
    local selected, loaded, autoLoad, status = "", "", false, ""
    local MAX_BYTES, MAX_CONFIGS = 131072, 128
    local controller = {}

    local function current()
        if not alive then return false end
        if type(ctx.IsCurrent) ~= "function" then return true end
        local ok, value = pcall(ctx.IsCurrent)
        return ok and value == true
    end
    local function normalizeName(value)
        if type(value) ~= "string" then return nil end
        value = string.match(value, "^%s*(.-)%s*$")
        if #value < 1 or #value > 48 or not string.match(value, "^[%w _%-]+$") then return nil end
        return value, string.lower(value)
    end
    local function configPath(key)
        return folder .. "/cfg_" .. key .. ".json"
    end
    local function decode(text)
        if type(text) ~= "string" or #text > MAX_BYTES then return nil end
        local ok, value = pcall(ctx.JSONDecode, text)
        return ok and type(value) == "table" and value or nil
    end
    local function encode(value)
        local ok, text = pcall(ctx.JSONEncode, value)
        if not ok or type(text) ~= "string" or #text > MAX_BYTES then return nil end
        return text
    end
    local function validate(values)
        if type(values) ~= "table" then return nil end
        local result, known, count = {}, 0, 0
        for key in pairs(values) do
            count = count + 1
            if count > 256 then return nil end
            if defaults[key] ~= nil then known = known + 1 end
        end
        if known == 0 then return nil end
        for key, default in pairs(defaults) do
            local value = values[key]
            if value == nil then value = default end
            local ok, normalized, problem = pcall(ctx.Normalize, key, value)
            if not ok or problem or normalized == nil then return nil end
            local kind = type(normalized)
            if kind ~= "boolean" and kind ~= "string" and kind ~= "number" then return nil end
            if kind == "number" and (normalized ~= normalized or math.abs(normalized) == math.huge) then return nil end
            result[key] = normalized
        end
        return result
    end
    local function capabilities()
        for _, name in ipairs({"readfile", "writefile", "listfiles", "isfile", "isfolder", "makefolder"}) do
            if type(files[name]) ~= "function" then return false end
        end
        return type(ctx.JSONEncode) == "function" and type(ctx.JSONDecode) == "function"
            and type(ctx.Normalize) == "function" and type(ctx.Snapshot) == "function"
            and type(ctx.Apply) == "function" and next(defaults) ~= nil
    end
    local function ensureStore()
        if not capabilities() then return false, "File access unavailable" end
        for _, path in ipairs({"DmcDaHood", folder}) do
            if not current() then return false, "Script reloaded" end
            local ok, exists = pcall(files.isfolder, path)
            if not ok then return false, "Folder unavailable" end
            if not exists then
                if not current() then return false, "Script reloaded" end
                local made, result = pcall(files.makefolder, path)
                if not made or result == false then return false, "Folder unavailable" end
                local checked, found = pcall(files.isfolder, path)
                if not checked or not found then return false, "Folder unavailable" end
            end
        end
        if not current() then return false, "Script reloaded" end
        return true
    end
    local function readFile(path)
        if not current() then return nil, "Script reloaded" end
        local ok, exists = pcall(files.isfile, path)
        if not ok then return nil, "Couldn't read config" end
        if not exists then return nil, "Config missing" end
        local readOK, text = pcall(files.readfile, path)
        if not current() then return nil, "Script reloaded" end
        if not readOK or type(text) ~= "string" then return nil, "Couldn't read config" end
        if #text > MAX_BYTES then return nil, "Config too large" end
        return text
    end
    local function writeFile(path, text)
        if not current() then return false, "Script reloaded" end
        local existsOK, exists = pcall(files.isfile, path)
        if not existsOK then return false, "Couldn't save config" end
        local previous
        if exists then
            local ok, value = pcall(files.readfile, path)
            if not ok or type(value) ~= "string" or #value > MAX_BYTES then return false, "Couldn't read existing file" end
            previous = value
            if previous == text then
                if not current() then return false, "Script reloaded" end
                return true
            end
        end
        if not current() then return false, "Script reloaded" end
        local wrote, result = pcall(files.writefile, path, text)
        if not current() then return false, "Script reloaded" end
        local readOK, actual = pcall(files.readfile, path)
        if not current() then return false, "Script reloaded" end
        if wrote and result ~= false and readOK and actual == text then return true end
        if previous ~= nil and current() then
            local restored, restoreResult = pcall(files.writefile, path, previous)
            if not current() then return false, "Script reloaded" end
            local verified, restoredText = pcall(files.readfile, path)
            if not restored or restoreResult == false or not verified or restoredText ~= previous then
                return false, "Save failed; restore failed"
            end
        elseif current() and type(files.delfile) == "function" then
            pcall(files.delfile, path)
        end
        return false, "Couldn't save config"
    end
    local function writeMetadata(name, enabled)
        local text = encode({Version = 1, AutoLoad = enabled, Name = name})
        if not text then return false, "Couldn't save auto load" end
        return writeFile(metaPath, text)
    end
    local function sortedNames()
        names = {}
        for _, entry in pairs(entries) do names[#names + 1] = entry.Name end
        table.sort(names, function(a, b)
            local x, y = string.lower(a), string.lower(b)
            return x == y and a < b or x < y
        end)
    end
    local function refreshList()
        if not current() then return false, "Script reloaded" end
        local ok, paths = pcall(files.listfiles, folder)
        if not current() then return false, "Script reloaded" end
        if not ok or type(paths) ~= "table" then return false, "Couldn't list configs" end
        local found, count, visited = {}, 0, 0
        for _, path in pairs(paths) do
            visited = visited + 1
            if visited > 1024 then return false, "Too many files" end
            if type(path) == "string" then
                local basename = string.match(string.gsub(path, "\\", "/"), "([^/]+)$")
                local candidate = basename and string.match(basename, "^cfg_(.+)%.json$")
                local name, key = normalizeName(candidate)
                if name and not found[key] then
                    count = count + 1
                    if count > MAX_CONFIGS then return false, "Too many configs" end
                    local canonical = configPath(key)
                    local text = readFile(canonical)
                    if not current() then return false, "Script reloaded" end
                    local record = text and decode(text)
                    local title, recordKey = normalizeName(record and record.Name)
                    if title and recordKey == key then name = title end
                    found[key] = {Name = name, Path = canonical}
                end
            end
        end
        entries = found
        sortedNames()
        local _, key = normalizeName(selected)
        if key and entries[key] then selected = entries[key].Name
        elseif selected ~= "" then selected = "" end
        return true
    end
    local function profile(name)
        local clean, key = normalizeName(name)
        if not clean then return nil, nil, "Choose a config" end
        local text, problem = readFile(configPath(key))
        if not text then return nil, nil, problem end
        local record = decode(text)
        if not record or record.Version ~= 1 then return nil, nil, "Invalid config" end
        local title, recordKey = normalizeName(record.Name)
        if not title or recordKey ~= key then return nil, nil, "Invalid config" end
        local values = validate(record.Settings)
        if not values then return nil, nil, "Invalid config" end
        return values, title
    end
    local function snapshot()
        local ok, values = pcall(ctx.Snapshot)
        return ok and validate(values) or nil
    end
    local function apply(values)
        if not current() then return false, "Script reloaded" end
        local ok, result = pcall(ctx.Apply, values)
        if not current() then return false, "Script reloaded" end
        return ok and result == true, "Couldn't apply config"
    end
    local function loadProfile(name, persist)
        local values, title, problem = profile(name)
        if not values then return false, problem end
        local previous = persist and snapshot() or nil
        if persist and not previous then return false, "Couldn't read settings" end
        local applied, applyProblem = apply(values)
        if not applied then return false, applyProblem end
        if persist then
            local saved, saveProblem = writeMetadata(title, autoLoad)
            if not saved then
                if not current() then return false, "Script reloaded" end
                local restored = apply(previous)
                return false, restored and saveProblem or "Load failed; restore failed"
            end
        end
        loaded, selected = title, title
        local _, key = normalizeName(title)
        entries[key] = {Name = title, Path = configPath(key)}
        sortedNames()
        return true, "Loaded " .. title
    end
    local function run(callback)
        if not current() then return false, "Script reloaded" end
        if busy then return false, "Working..." end
        busy = true
        local ok, success, message = pcall(callback)
        busy = false
        if not ok then success, message = false, "Config operation failed" end
        if current() then status = message or "" end
        return success == true, message
    end
    local function ready()
        return initialized and available and current()
    end
    local function initialize()
            if initialized then return available, status end
            local ok, problem = ensureStore()
            if not ok then available = false; return false, problem end
            local listed, listProblem = refreshList()
            if not listed then available = false; return false, listProblem end
            available, initialized = true, true
            local existsOK, exists = pcall(files.isfile, metaPath)
            if not current() then return false, "Script reloaded" end
            if not existsOK then return false, "Couldn't read auto load" end
            if not exists then return true, "" end
            local text = readFile(metaPath)
            local metadata = text and decode(text)
            if not metadata or metadata.Version ~= 1 or type(metadata.AutoLoad) ~= "boolean"
                or type(metadata.Name) ~= "string" then return false, "Invalid auto load settings" end
            local name, key = normalizeName(metadata.Name)
            if metadata.Name ~= "" and not name then return false, "Invalid auto load settings" end
            if metadata.AutoLoad and not name then return false, "Invalid auto load settings" end
            loaded, autoLoad = name or "", metadata.AutoLoad
            selected = key and entries[key] and entries[key].Name or ""
            if autoLoad then return loadProfile(loaded, false) end
            return true, ""
    end
    function controller:Initialize()
        return run(initialize)
    end
    function controller:Refresh()
        return run(function()
            if not initialized then return initialize() end
            local ok, problem = ensureStore()
            if not ok then available = false; return false, problem end
            local refreshed, refreshProblem = refreshList()
            if not refreshed then return false, refreshProblem end
            available = true
            return true, status
        end)
    end
    function controller:Select(name)
        return run(function()
            if not ready() then return false, "File access unavailable" end
            local _, key = normalizeName(name)
            if not key or not entries[key] then return false, "Choose a config" end
            selected = entries[key].Name
            return true, autoLoad and loaded ~= "" and ("Auto load: " .. loaded) or status
        end)
    end
    function controller:Save(name)
        return run(function()
            if not ready() then return false, "File access unavailable" end
            local title, key = normalizeName(name)
            if not title then return false, "Use 1-48 letters, numbers, spaces, - or _" end
            local count = 0
            for _ in pairs(entries) do count = count + 1 end
            if not entries[key] and count >= MAX_CONFIGS then return false, "Too many configs" end
            local values = snapshot()
            if not values then return false, "Couldn't read settings" end
            local text = encode({Version = 1, Name = title, Settings = values})
            if not text then return false, "Couldn't save config" end
            local saved, problem = writeFile(configPath(key), text)
            if not saved then return false, problem end
            entries[key] = {Name = title, Path = configPath(key)}
            selected = title
            sortedNames()
            return true, "Saved " .. title
        end)
    end
    function controller:Load(name)
        return run(function()
            if not ready() then return false, "File access unavailable" end
            return loadProfile(name, true)
        end)
    end
    function controller:SetAutoLoad(value)
        return run(function()
            if not ready() then return false, "File access unavailable" end
            if type(value) ~= "boolean" then return false, "Invalid auto load option" end
            if value and loaded == "" then return false, "Load a config first" end
            if value then
                local values = profile(loaded)
                if not values then return false, "Load a config first" end
            end
            local saved, problem = writeMetadata(loaded, value)
            if not saved then return false, problem end
            autoLoad = value
            return true, value and ("Auto load: " .. loaded) or "Auto load off"
        end)
    end
    function controller:GetState()
        local listed = {}
        for index, name in ipairs(names) do listed[index] = name end
        return {Names = listed, Selected = selected, Loaded = loaded, AutoLoad = autoLoad,
            Available = available and alive, Busy = busy, Status = status}
    end
    function controller:Destroy()
        alive, available = false, false
        status = ""
    end
    return controller
end

