        OriginalAim = GunHandler.getAim, SilentActive = silentActive,
    })
    if not isCurrent() then
        pcall(selector.Destroy, selector)
        selector = nil
        return
    end
    visual = buildVisualRedirect({
        Settings = Settings, LocalPlayer = LocalPlayer, GunHandler = GunHandler,
        Workspace = workspace, Track = track, Clock = os.clock,
        ReferencePoint = referencePoint, OriginalAim = GunHandler.getAim,
        SilentActive = silentActive, OnError = reportOnce,
    })
    router = buildShotRouter({
        GunHandler = GunHandler, Selector = selector, Settings = Settings,
        LocalPlayer = LocalPlayer, Clock = os.clock, Visual = visual, Hitbox = hitbox,
        SilentActive = silentActive, OnError = reportOnce,
    })
    trigger = buildTriggerbot({
        Settings = Settings, Players = Players, LocalPlayer = LocalPlayer,
        UserInputService = UserInputService, Workspace = workspace,
        ReferencePoint = referencePoint, Clock = os.clock,
        MenuOpen = function() return ui and ui:IsVisible() end,
        GetAimTarget = function() return selector and selector:PeekTarget() end,
        SilentActive = silentActive, Hitbox = hitbox,
        MouseClick = fileFunction("mouse1click"),
        MousePress = fileFunction("mouse1press"), MouseRelease = fileFunction("mouse1release"),
    })
    local function renderTrigger()
        if not running or not trigger then return end
        local ok, failure = pcall(trigger.Step, trigger)
        if not ok then reportOnce("triggerbot", failure) end
    end
    local renderBound = pcall(function()
        local binding = "DH_Trigger_" .. HttpService:GenerateGUID(false)
        RunService:BindToRenderStep(binding, Enum.RenderPriority.Camera.Value + 1, renderTrigger)
        triggerRenderBinding = binding
    end)
    if not renderBound then track(RunService.RenderStepped, renderTrigger) end
    movement = buildMovementController({
        Settings = Settings, LocalPlayer = LocalPlayer, Clock = os.clock, OnError = reportOnce,
    })
    jump = buildJumpController({
        Settings = Settings, LocalPlayer = LocalPlayer,
    })
    local resumeAt = 0
    track(RunService.Heartbeat, function(dt)
        if not running then return end
        local now = os.clock()
        if now >= resumeAt then
            local ok, failure = pcall(selector.Step, selector, dt)
            if not ok then
                selector:Invalidate()
                resumeAt = now + 0.5
                reportOnce("target selection", failure)
            end
        end
        local ok, failure = pcall(visual.Step, visual)
        if not ok then reportOnce("tracer update", failure) end
    end)
    track(RunService.PreSimulation or RunService.Heartbeat, function()
        if not running then return end
        local ok, failure = pcall(movement.Step, movement)
        if not ok then
            pcall(movement.Invalidate, movement)
            reportOnce("movement", failure)
        end
        local jumpOK, jumpFailure = pcall(jump.Refresh, jump)
        if not jumpOK then
            pcall(jump.Invalidate, jump)
            reportOnce("jump", jumpFailure)
        end
    end)
    local function invalidateCharacter()
        if trigger then trigger:Invalidate() end
        selector:Invalidate()
        router:Invalidate()
        visual:Invalidate()
        movement:Invalidate()
        jump:Invalidate()
        hitbox:Invalidate()
        particles:Invalidate()
    end
    track(LocalPlayer.CharacterAdded, invalidateCharacter)
    if LocalPlayer.CharacterRemoving then
        track(LocalPlayer.CharacterRemoving, invalidateCharacter)
    end
    track(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
        selector:Invalidate(true)
    end)
    ui:Sync()

    router:Install()
    if hitbox:SetRoutingReady(true) == false then error("Hitbox shot routing was not ready", 0) end
    hitbox:Refresh()
    particles:Refresh()
end)
if not initialized and isCurrent() then
    cleanup()
    if (env.__DH_GunHandlerAimUI == nil or env.__DH_GunHandlerAimUI == state)
        and UserInputService.MouseIconEnabled == true then
        UserInputService.MouseIconEnabled = initialMouseIcon
    end
    error("[Dmc | Da Hood] Setup failed: " .. tostring(problem), 0)
end
