    local function rebuildConfigOptions(names)
        local sorted = {}
        for _, name in ipairs(names) do if type(name) == "string" then sorted[#sorted + 1] = name end end
        table.sort(sorted)
        local same = #sorted == #configsDropdown.Names
        if same then
            for index, name in ipairs(sorted) do
                if name ~= configsDropdown.Names[index] then same = false; break end
            end
        end
        if same then return end
        configUI.ClearOptions()
        configsDropdown.Names = sorted
        configsDropdown.ContentHeight = #sorted * 22 + 6
        configsMenu.CanvasSize = UDim2.fromOffset(0, configsDropdown.ContentHeight)
        configsMenu.CanvasPosition = Vector2.new(0, 0)
        for index, name in ipairs(sorted) do
            local choice = name
            local option = make("TextButton", configsMenu, {
                Name = "ConfigOption" .. tostring(index), Position = UDim2.fromOffset(3, 3 + (index - 1) * 22),
                Size = UDim2.new(1, -6, 0, 21), BorderSizePixel = 0,
