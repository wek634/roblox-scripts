    local function clampPanel()
        if geometryDepth > 0 then return end
        local area = canvas.AbsoluteSize
        if area.X <= 0 or area.Y <= 0 then return end
        local width = math.clamp(panel.Size.X.Offset, math.min(MIN_WIDTH, area.X), area.X)
        local height = math.clamp(panel.Size.Y.Offset, math.min(MIN_HEIGHT, area.Y), area.Y)
        local x = math.clamp(panel.Position.X.Offset, 0, math.max(0, area.X - width))
        local y = math.clamp(panel.Position.Y.Offset, 0, math.max(0, area.Y - height))
        if x ~= panel.Position.X.Offset or y ~= panel.Position.Y.Offset
            or width ~= panel.Size.X.Offset or height ~= panel.Size.Y.Offset then
            applyRectangle(x, y, width, height)
        end
        rememberGeometry()
        if previewWidget then previewWidget:Position() end
        if activeDropdown then positionDropdown(activeDropdown) end
    end
