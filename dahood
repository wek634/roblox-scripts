    local function resolveProperty(slider)
        return type(slider.Property) == "function" and slider.Property() or slider.Property
    end
    local function numericValue(slider, property)
        local value = tonumber(Settings[property or resolveProperty(slider)])
        if not value or value ~= value or math.abs(value) == math.huge then value = slider.Default end
        return math.clamp(value, slider.Minimum, slider.Maximum)
    end
    local function quantize(slider, value)
        local steps = math.floor((value - slider.Minimum) / slider.Step + 0.5)
        return math.clamp(slider.Minimum + steps * slider.Step, slider.Minimum, slider.Maximum)
    end
    local function formatNumber(slider, value)
        return string.format("%." .. tostring(slider.Decimals) .. "f", value)
    end
