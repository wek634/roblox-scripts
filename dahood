                    if not advanced then break end
                end
                for _, accessory in ipairs(accessoryOffsets) do
                    if placed[accessory.Body] then
                        accessory.Handle.CFrame = accessory.Body.CFrame * accessory.Relative
                        for _, piece in ipairs(accessory.Pieces) do
                            piece.Part.CFrame = accessory.Handle.CFrame * piece.Relative
                        end
                    end
                end
            end
        end
        local function rebuildAvatar()
            if model then model:Destroy(); model = nil end
            avatarParts, rootPart = {}, nil
            sourceCharacter = ctx.LocalPlayer and ctx.LocalPlayer.Character
            if sourceCharacter and sourceCharacter:IsA("Model") then
                local oldArchivable = sourceCharacter.Archivable
                local ok, clone = pcall(function()
                    sourceCharacter.Archivable = true
                    return sourceCharacter:Clone()
                end)
                pcall(function() sourceCharacter.Archivable = oldArchivable end)
                if ok and clone then
                    clone.Name = "PreviewCharacter"
                    for _, descendant in ipairs(clone:GetDescendants()) do
                        if descendant.Parent then
                            if descendant:IsA("LuaSourceContainer") or descendant:IsA("Tool")
                                or descendant:IsA("Sound") or descendant:IsA("ParticleEmitter")
                                or descendant:IsA("Beam") or descendant:IsA("Trail")
                                or descendant:IsA("BillboardGui") or descendant:IsA("SurfaceGui")
                                or descendant.Name == "DH_HitboxProxy" or descendant.Name == "BodyEffects" then
                                descendant:Destroy()
                            elseif descendant:IsA("BasePart") then
                                descendant.Anchored = true
                                descendant.CanCollide = false
                                descendant.CanTouch = false
                                descendant.CanQuery = false
                                descendant.CastShadow = false
                            end
                        end
                    end
                    if clone:FindFirstChildWhichIsA("BasePart", true) then
                        clone.Parent = scene
                        local pivotOK = pcall(function()
                            clone:PivotTo(CFrame.new())
                            makeStandingPose(clone)
                        end)
                        if pivotOK then model = clone else clone:Destroy() end
                    else
                        clone:Destroy()
                    end
                end
            end
            if not model then model = makeDummy() end
            rootPart = model:FindFirstChild("HumanoidRootPart", true)
            originalRootFrame = rootPart and rootPart.CFrame or nil
            baseBodyParts, attachedAccessories, appliedThickness = {}, {}, nil
            neutralBodyScaleX, neutralBodyScaleZ = 1, 1
            local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
            if torso and torso:IsA("BasePart") then
                local width, depth = torso.Size.X, torso.Size.Z
                if width > 0.15 and depth > 0.1 then
                    neutralBodyScaleX = math.clamp(2 / width, 0.5, 3)
                    neutralBodyScaleZ = math.clamp(1 / depth, 0.5, 3)
                end
            end
            local movedParts = {}
            if originalRootFrame then
                for _, part in ipairs(model:GetChildren()) do
                    if part:IsA("BasePart") and part ~= rootPart
                        and part.Name ~= "Head" and KNOWN_BODY_PARTS[part.Name] then
                        local geometry = {
                            Part = part, Size = part.Size, Frame = part.CFrame,
                            RootPosition = originalRootFrame:PointToObjectSpace(part.Position),
                        }
                        baseBodyParts[#baseBodyParts + 1] = geometry
                        movedParts[part] = true
                    end
                end
                for _, accessory in ipairs(model:GetChildren()) do
                    if accessory:IsA("Accessory") then
                        local handle = accessory:FindFirstChild("Handle")
                        if handle and handle:IsA("BasePart") then
                            local attachedTo
                            for _, joint in ipairs(accessory:GetDescendants()) do
                                if joint:IsA("Weld") or joint:IsA("WeldConstraint") then
                                    if joint.Part0 == handle and movedParts[joint.Part1] then
                                        attachedTo = joint.Part1
                                    elseif joint.Part1 == handle and movedParts[joint.Part0] then
                                        attachedTo = joint.Part0
                                    end
                                    if attachedTo then break end
                                end
                            end
                            if attachedTo then
                                local pieces = {}
                                for _, piece in ipairs(accessory:GetDescendants()) do
                                    if piece:IsA("BasePart") then
                                        pieces[#pieces + 1] = {
                                            Part = piece,
                                            Offset = attachedTo.CFrame:ToObjectSpace(piece.CFrame),
                                        }
                                    end
                                end
                                attachedAccessories[#attachedAccessories + 1] = {
                                    Body = attachedTo, Pieces = pieces,
                                }
                            end
                        end
                    end
                end
            end
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") and part ~= rootPart and KNOWN_BODY_PARTS[part.Name] then
                    avatarParts[#avatarParts + 1] = {Part = part, Color = part.Color}
                end
            end
        end
        local function updatePreviewThickness()
            if not model or not rootPart or not originalRootFrame then return end
            local thickness = tonumber(Settings.PreviewThickness) or 1
            thickness = math.clamp(thickness, 0.5, 2)
            if appliedThickness == thickness then return end
            local widthFactor = thickness * neutralBodyScaleX
            local depthFactor = thickness * neutralBodyScaleZ
            for _, record in ipairs(baseBodyParts) do
                local part = record.Part
                if part.Parent then
                    local p = record.RootPosition
                    local position = originalRootFrame:PointToWorldSpace(
                        Vector3.new(p.X * widthFactor, p.Y, p.Z * depthFactor))
                    part.Size = Vector3.new(record.Size.X * widthFactor,
                        record.Size.Y, record.Size.Z * depthFactor)
                    part.CFrame = CFrame.new(position) * record.Frame.Rotation
                end
            end
            for _, accessory in ipairs(attachedAccessories) do
                if accessory.Body.Parent then
                    for _, piece in ipairs(accessory.Pieces) do
                        if piece.Part.Parent then
                            piece.Part.CFrame = accessory.Body.CFrame * piece.Offset
                        end
                    end
                end
            end
            appliedThickness = thickness
        end
        local function drawEdge(part, a, b)
            local delta = b - a
            part.Size = Vector3.new(0.045, 0.045, math.max(0.025, delta.Magnitude))
            part.CFrame = CFrame.lookAt((a + b) * 0.5, b)
        end
        local function updateCamera()
            local extent = math.max(6.5, currentBoxSize.X, currentBoxSize.Y, currentBoxSize.Z)
            local distance = math.max(10, extent * 1.45) * zoom
            local target = Vector3.new(0, 0.25, 0)
            local pitchCos = math.cos(pitch)
            local position = target + Vector3.new(math.sin(yaw) * pitchCos,
                math.sin(pitch), math.cos(yaw) * pitchCos) * distance
            previewCamera.CFrame = CFrame.lookAt(position, target)
        end
        local function previewColor()
            return Color3.fromRGB(Settings.HitboxColorR, Settings.HitboxColorG, Settings.HitboxColorB)
        end
        local function ensureEdge(index)
            local part = edges[index]
            if not part then
                part = make("Part", scene, {
                    Name = "BoxEdge" .. tostring(index), Anchored = true,
                    CanCollide = false, CanQuery = false, CanTouch = false,
                    CastShadow = false, Color = previewColor(),
                    Material = Enum.Material.SmoothPlastic,
                    Transparency = 1, Size = Vector3.new(0.04, 0.04, 1),
                })
                edges[index] = part
            end
            return part
        end
        local function ensureFill(index)
            local part = selectedFills[index]
            if not part then
                part = make("Part", scene, {
                    Name = "SelectedBox" .. tostring(index), Anchored = true,
                    CanCollide = false, CanQuery = false, CanTouch = false,
                    CastShadow = false, Color = previewColor(),
                    Material = Enum.Material.SmoothPlastic,
                    Transparency = 1, Size = Vector3.new(1, 1, 1),
                })
                selectedFills[index] = part
            end
            return part
        end
        function controller:Update()
            if destroyed or not holder.Visible then return end
            if not model then rebuildAvatar() end
            updatePreviewThickness()
            local requestedX = tonumber(Settings.HitboxX) or 5
            local requestedY = tonumber(Settings.HitboxY) or 5
            local requestedZ = tonumber(Settings.HitboxZ) or 5
            local color = previewColor()
            local active = Settings.HitboxEnabled == true and
                requestedX > 0 and requestedY > 0 and requestedZ > 0
            local selectedMode = Settings.HitboxTarget == "SelectedParts"
            local edgeIndex, fillIndex, selectedCount = 1, 1, 0
            local function volume(frame, size, selected)
                local fill
                if selected then
                    fill = ensureFill(fillIndex)
                    fillIndex = fillIndex + 1
                else
                    fill = boxFill
                end
                fill.Size, fill.CFrame = size, frame
                fill.Color, fill.Transparency = color, 0.95
                local half = size * 0.5
                local function edge(a, b)
                    local part = ensureEdge(edgeIndex)
                    part.Color, part.Transparency = color, 0.15
                    drawEdge(part, frame:PointToWorldSpace(a), frame:PointToWorldSpace(b))
                    edgeIndex = edgeIndex + 1
                end
                for _, y in ipairs({-half.Y, half.Y}) do
                    for _, z in ipairs({-half.Z, half.Z}) do
                        edge(Vector3.new(-half.X, y, z), Vector3.new(half.X, y, z))
                    end
                end
                for _, x in ipairs({-half.X, half.X}) do
                    for _, z in ipairs({-half.Z, half.Z}) do
                        edge(Vector3.new(x, -half.Y, z), Vector3.new(x, half.Y, z))
                    end
                end
                for _, x in ipairs({-half.X, half.X}) do
                    for _, y in ipairs({-half.Y, half.Y}) do
                        edge(Vector3.new(x, y, -half.Z), Vector3.new(x, y, half.Z))
                    end
                end
            end
            local layout = "None"
            currentBoxSize = Vector3.new(requestedX, requestedY, requestedZ)
            if active and model then
                local volumes, selectedLayout, count = hitboxVolumes(model, Settings,
                    requestedX, requestedY, requestedZ)
                layout, selectedCount = selectedLayout, count
                for _, entry in ipairs(volumes) do
                    if entry.part.Parent then
                        currentBoxSize = entry.size
                        volume(entry.part.CFrame, entry.size, layout == "Parts")
                    end
                end
            end
            if selectedMode and layout == "Parts" then boxFill.Transparency = 1 end
            if not active then boxFill.Transparency = 1 end
            for index = edgeIndex, #edges do edges[index].Transparency = 1 end
            for index = fillIndex, #selectedFills do selectedFills[index].Transparency = 1 end
            for _, entry in ipairs(avatarParts) do
                if entry.Part.Parent and entry.Part.Color ~= entry.Color then
                    entry.Part.Color = entry.Color
                end
            end
            sizeInfo.Text = string.format("%.1fx%.1fx%.1f  Body %.2fx",
                currentBoxSize.X, currentBoxSize.Y, currentBoxSize.Z,
                tonumber(Settings.PreviewThickness) or 1)
            if layout == "AllParts" then
                modeInfo.Text = "All parts  |  Root box"
            elseif layout == "SelectedRoot" then
                modeInfo.Text = "Selected parts: " .. tostring(selectedCount) .. "  |  Root box"
            elseif layout == "Parts" then
                modeInfo.Text = "Selected parts: " .. tostring(selectedCount)
            else
                modeInfo.Text = "Nearest part  |  Root box"
            end
            holder.BackgroundColor3 = colors.Background
            viewport.BackgroundColor3 = colors.Input
            updateCamera()
        end
        function controller:Position()
            local area = canvas.AbsoluteSize
            if area.X <= 0 or area.Y <= 0 then return end
            local size = previewHeight
            local width = previewWidth
            holder.Size = UDim2.fromOffset(width, math.min(size, math.max(230, area.Y - 12)))
            local x = panel.Position.X.Offset + panel.Size.X.Offset + 11
            local y = panel.Position.Y.Offset
            if x + width > area.X - 5 then
                local left = panel.Position.X.Offset - width - 11
                x = left >= 5 and left or math.max(5, area.X - width - 5)
            end
            x = math.clamp(x, 0, math.max(0, area.X - width))
            y = math.clamp(y, 0, math.max(0, area.Y - holder.Size.Y.Offset))
            holder.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
        end
        function controller:SetVisible(value)
            local show = value == true and activeTab == "Exploits" and Settings.PreviewEnabled == true
                and Settings.HitboxEnabled == true and Settings.StreamMode ~= true and gui.Enabled
            if not show then
                dragging, dragLast = nil, nil
                if model then model:Destroy(); model = nil end
                avatarParts, rootPart = {}, nil
                baseBodyParts, attachedAccessories = {}, {}
                originalRootFrame, appliedThickness = nil, nil
                neutralBodyScaleX, neutralBodyScaleZ = 1, 1
            end
            holder.Visible = show
            if show then self:Position(); self:Update() end
        end
        function controller:RefreshAvatar()
            if not holder.Visible then
                if model then model:Destroy(); model = nil end
                return
            end
            rebuildAvatar()
            self:Update()
        end
        function controller:Destroy()
            dragging = nil
            holder.Visible = false
            if model then model:Destroy(); model = nil end
            baseBodyParts, attachedAccessories = {}, {}
            originalRootFrame, appliedThickness = nil, nil
            neutralBodyScaleX, neutralBodyScaleZ = 1, 1
            holder:Destroy()
        end
        Track(viewport.InputBegan, function(input)
            if not holder.Visible or not gui.Enabled then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
                input.UserInputType == Enum.UserInputType.Touch then
                dragging = input
                dragLast = Vector2.new(input.Position.X, input.Position.Y)
            end
        end)
        Track(Input.InputChanged, function(input)
            if not holder.Visible or not gui.Enabled then return end
            if input.UserInputType == Enum.UserInputType.MouseWheel then
                local mouse = Input:GetMouseLocation()
                local p, s = viewport.AbsolutePosition, viewport.AbsoluteSize
                if mouse.X >= p.X and mouse.Y >= p.Y and mouse.X <= p.X+s.X and mouse.Y <= p.Y+s.Y then
                    zoom = math.clamp(zoom * (input.Position.Z > 0 and 0.89 or 1.12), 0.65, 2.9)
                    updateCamera()
                end
            elseif dragging and (input == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1
                    and input.UserInputType == Enum.UserInputType.MouseMovement)) then
                local position = Vector2.new(input.Position.X, input.Position.Y)
                if dragLast then
                    local movement = position - dragLast
                    yaw = yaw - movement.X * 0.012
                    pitch = math.clamp(pitch + movement.Y * 0.01, -1.15, 1.15)
                    updateCamera()
                end
                dragLast = position
            end
        end)
        Track(Input.InputEnded, function(input)
            if dragging and (input == dragging or input.UserInputType == dragging.UserInputType) then
                dragging, dragLast = nil, nil
            end
        end)
        Track(Input.WindowFocusReleased, function()
            dragging, dragLast = nil, nil
        end)
        if ctx.LocalPlayer then
            Track(ctx.LocalPlayer.CharacterAdded, function()
                task.defer(function()
                    if not destroyed then controller:RefreshAvatar() end
                end)
            end)
            Track(ctx.LocalPlayer.CharacterAppearanceLoaded, function()
                if not destroyed then controller:RefreshAvatar() end
            end)
        end
        return controller
    end
