    return #failures == 0, table.concat(failures, " | ")
end
local function applyConfiguration(values)
    if not isCurrent() then return false, "Script unloaded" end
    if type(values) ~= "table" then return false, "Invalid config" end
    local validated = {}
    for key in pairs(DefaultSettings) do
        local value, problem = normalizeSetting(key, values[key])
        if problem then return false, "Invalid config" end
        validated[key] = value
    end
    local previousValues = snapshotConfiguration()
    for key, value in pairs(validated) do Settings[key] = value end
    local called, updated = pcall(refreshConfiguration)
    local ok = called and updated == true
    if not called then reportOnce("config apply", updated) end
    if not isCurrent() then return false, "Script unloaded" end
    if ok and ui then
        local synced, failure = pcall(ui.Sync, ui)
        if not synced then
            reportOnce("config UI", failure)
            ok = false
        end
    end
    if not ok then
        for key, value in pairs(previousValues) do Settings[key] = value end
        local restored, restoreResult = pcall(refreshConfiguration)
        if not restored or restoreResult ~= true then
            reportOnce("config restore", restored and "Controller restore incomplete" or restoreResult)
        end
        if isCurrent() and ui then
            local synced, failure = pcall(ui.Sync, ui)
            if not synced then reportOnce("config UI restore", failure) end
        end
        return false, "Could not apply config"
    end
    return true
end
