        if not canInteractWindow() or dragInput then return end
        if closeColorPicker then closeColorPicker() end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if kind == "slider" and not canInteractRow(slider.Row) then return end
        closeDropdown()
        dragInput, dragKind, dragSlider = input, kind, slider
        dragStart, panelStart = input.Position, panel.Position
        panelDragStarted = false
        if slider then
            dragProperty = resolveProperty(slider)
            moveSlider(slider, dragProperty, input.Position)
