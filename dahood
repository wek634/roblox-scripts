local AIM_PISTOL_NAMES = {
    ["[Revolver]"] = true, ["[Glock]"] = true, ["[Silencer]"] = true,
    ["[USP]"] = true, ["[Pistol]"] = true, ["[Flintlock]"] = true,
}
local function isSameTeam(localPlayer, otherPlayer, playersService)
    if not localPlayer or not otherPlayer or localPlayer == otherPlayer then return false end
    if playersService:GetAttribute("ServerMode") == "Ranked" then
        local ownMatch = localPlayer:GetAttribute("RankedMatchId")
        local otherMatch = otherPlayer:GetAttribute("RankedMatchId")
        local ownRound = localPlayer:GetAttribute("RankedRoundId")
        local otherRound = otherPlayer:GetAttribute("RankedRoundId")
        local ownTeam = localPlayer:GetAttribute("RankedTeam")
        local otherTeam = otherPlayer:GetAttribute("RankedTeam")
        return type(ownMatch) == "string" and ownMatch ~= "" and ownMatch == otherMatch
            and type(ownRound) == "string" and ownRound ~= "" and ownRound == otherRound
            and type(ownTeam) == "number" and ownTeam > 0 and ownTeam == ownTeam
            and type(otherTeam) == "number" and ownTeam == otherTeam
    end
    return localPlayer.Team ~= nil and not localPlayer.Neutral
        and not otherPlayer.Neutral and otherPlayer.Team == localPlayer.Team
end

local function classifyWeapon(tool)
    local name = tool and tool.Name or ""
    local lower = string.lower(name)
    if string.find(lower, "shotgun", 1, true) or string.find(lower, "double-barrel", 1, true)
        or string.find(lower, "doublebarrel", 1, true) then return "Shotguns" end
    return AIM_PISTOL_NAMES[name] and "Pistols" or "Other"
end

