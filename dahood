local function chooseGuiHost(playerGui, environment)
    local function usable(host)
        if typeof(host) ~= "Instance" then return false end
        local probe = Instance.new("ScreenGui")
        probe.Enabled = false
        local ok = pcall(function()
            assert(host ~= playerGui and not host:IsDescendantOf(playerGui))
            probe.Parent = host
        end)
        probe:Destroy()
        return ok
    end
    local hiddenGui = environment.gethui or _G.gethui
    if type(hiddenGui) == "function" then
        local ok, host = pcall(hiddenGui)
        if ok and usable(host) then return host end
    end
    local ok, host = pcall(game.GetService, game, "CoreGui")
    if ok and usable(host) then return host end
    return playerGui
end

