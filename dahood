        })
        local slider = {
            Property = property, Minimum = minimum, Maximum = maximum, Step = step,
            Default = defaultValue, Decimals = decimals or 0, Row = row,
            Button = button, Fill = fill, NumberBox = numberBox,
        }
        sliders[#sliders + 1] = slider
        bindFeedback(button, function(state)
            return {
