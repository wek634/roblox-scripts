        if not dragHeld() or not canInteractRow(slider.Row) then return end
        local fraction = math.clamp((position.X - slider.Button.AbsolutePosition.X)
            / math.max(1, slider.Button.AbsoluteSize.X), 0, 1)
        local value = quantize(slider, slider.Minimum + fraction * (slider.Maximum - slider.Minimum))
        if value ~= Settings[property] then changeSetting(property, value) end
