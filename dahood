            if current == Enum.GuiState.Press then state = "Press"
            elseif current == Enum.GuiState.Hover then state = "Hover" end
        end
        for _, target in ipairs(entry.Style(state)) do
            setFeedbackGoal(target.Object, target.Goals, instant)
        end
