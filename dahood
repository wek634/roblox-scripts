    local function endDrag()
        dragInput, dragKind, dragStart, panelStart, dragSlider, dragProperty = nil, nil, nil, nil, nil, nil
        resizeEdges, resizeStart = nil, nil
        panelDragStarted = false
    end
    local function dragHeld()
        if not dragInput then return false end
        if dragInput.UserInputState == Enum.UserInputState.Cancel
            or dragInput.UserInputState == Enum.UserInputState.End then
            endDrag()
            return false
        end
        if dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and not Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            endDrag()
            return false
        end
        return true
    end
