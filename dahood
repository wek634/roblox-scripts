                }},
                { Object = rail, Goals = {
                    BackgroundColor3 = feedbackColor(state, colors.Input, colors.Hover, colors.Press),
                }},
            }
        end, function() return canInteractRow(row) end)
        bindFeedback(numberBox, function(state)
            return {{ Object = numberBox, Goals = {
                BackgroundColor3 = feedbackColor(state, colors.Input, colors.Hover, colors.Press),
                BorderColor3 = feedbackColor(state, colors.Border, colors.BorderHover, colors.BorderPress),
            }}}
        end, function() return canInteractRow(row) end)
        Track(numberBox.Focused, function()
            if not canInteractRow(row) then
                slider.EditingProperty = nil
                numberBox.Text = formatNumber(slider, numericValue(slider))
                if Input:GetFocusedTextBox() == numberBox then numberBox:ReleaseFocus() end
                return
            end
            slider.EditingProperty = resolveProperty(slider)
        end)
        Track(numberBox.FocusLost, function()
            if destroyed then return end

            local mayCommit = slider.EditingProperty ~= nil or canInteractRow(row)
            local propertyName = slider.EditingProperty or resolveProperty(slider)
            slider.EditingProperty = nil
            local value = tonumber(numberBox.Text)
            if mayCommit and value and value == value and math.abs(value) < math.huge then
                changeSetting(propertyName, quantize(slider, value))
            end
            numberBox.Text = formatNumber(slider, numericValue(slider))
        end)
    end

