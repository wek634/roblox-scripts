    local function beginResize(input, edges)
        if not canInteractWindow() or dragInput then return end
        if closeColorPicker then closeColorPicker() end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        closeDropdown()
        releaseInputFocus()
        clampPanel()
        local area = canvas.AbsoluteSize
        if area.X <= 0 or area.Y <= 0 then return end
        local x, y = panel.Position.X.Offset, panel.Position.Y.Offset
        resizeStart = {
            Left = x, Top = y, Right = x + panel.Size.X.Offset,
            Bottom = y + panel.Size.Y.Offset, ViewWidth = area.X, ViewHeight = area.Y,
        }
        resizeEdges, dragInput, dragKind, dragStart = edges, input, "resize", input.Position
    end
    local function moveResize(position)
        local area = canvas.AbsoluteSize
        if not resizeStart or area.X <= 0 or area.Y <= 0 then endDrag(); return end
        if area.X ~= resizeStart.ViewWidth or area.Y ~= resizeStart.ViewHeight then
            endDrag()
            clampPanel()
            return
        end
        local delta = position - dragStart
        local minWidth, minHeight = math.min(MIN_WIDTH, area.X), math.min(MIN_HEIGHT, area.Y)
        local left, right = resizeStart.Left, resizeStart.Right
        local top, bottom = resizeStart.Top, resizeStart.Bottom
        if resizeEdges.West then left = math.clamp(left + delta.X, 0, right - minWidth) end
        if resizeEdges.East then right = math.clamp(right + delta.X, left + minWidth, area.X) end
        if resizeEdges.North then top = math.clamp(top + delta.Y, 0, bottom - minHeight) end
        if resizeEdges.South then bottom = math.clamp(bottom + delta.Y, top + minHeight, area.Y) end
        applyRectangle(left, top, right - left, bottom - top)
    end
