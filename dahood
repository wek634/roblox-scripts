    local resumeAt = 0
    track(RunService.Heartbeat, function(dt)
        if not running then return end
        local now = os.clock()
        if now >= resumeAt then
            local ok, failure = pcall(selector.Step, selector, dt)
            if not ok then
                selector:Invalidate()
                resumeAt = now + 0.5
                reportOnce("target selection", failure)
            end
        end
        local ok, failure = pcall(visual.Step, visual)
        if not ok then reportOnce("tracer update", failure) end
    end)
    track(RunService.PreSimulation or RunService.Heartbeat, function()
        if not running then return end
        local ok, failure = pcall(movement.Step, movement)
        if not ok then
            pcall(movement.Invalidate, movement)
            reportOnce("movement", failure)
        end
    end)
    local function invalidateCharacter()
        selector:Invalidate()
        router:Invalidate()
        visual:Invalidate()
        movement:Invalidate()
        hitbox:Invalidate()
        particles:Invalidate()
    end
    track(LocalPlayer.CharacterAdded, invalidateCharacter)
    if LocalPlayer.CharacterRemoving then
        track(LocalPlayer.CharacterRemoving, invalidateCharacter)
    end
    track(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
        selector:Invalidate(true)
    end)
    ui:Sync()

    router:Install()
    if hitbox:SetRoutingReady(true) == false then error("Hitbox shot routing was not ready", 0) end
    hitbox:Refresh()
    particles:Refresh()
end)
if not initialized and isCurrent() then
