    for _, entry in ipairs({{hitbox, "hitboxes"}, {particles, "particles"}}) do
        local object, area = entry[1], entry[2]
        if object then
            local ok, result = pcall(object.GetDiagnostics, object)
            if not ok or type(result) ~= "table"
                or (tonumber(result.pendingRestore) or 0) > 0
                or (tonumber(result.unsafeQueries) or 0) > 0 then
                failures[#failures + 1] = area .. " cleanup is incomplete"
