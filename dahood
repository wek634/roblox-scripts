    local function stopFeedbackTween(object)
        local entry = feedbackTweens[object]
        if not entry then return end
        feedbackTweens[object] = nil
        if entry.Connection then entry.Connection:Disconnect() end
        entry.Tween:Cancel()
        entry.Tween:Destroy()
    end
    local function cancelFeedbackTweens()
        for object in pairs(feedbackTweens) do stopFeedbackTween(object) end
        feedbackGoals = {}
    end
    local function applyTheme()
        local signature = table.concat({
            Settings.AccentR, Settings.AccentG, Settings.AccentB,
            Settings.SurfaceR, Settings.SurfaceG, Settings.SurfaceB,
        }, ":")
        if signature == themeSignature then return end
        themeSignature = signature
        cancelFeedbackTweens()
        local function color(r, g, b)
            return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
        end
        local r, g, b = Settings.SurfaceR, Settings.SurfaceG, Settings.SurfaceB
        local ar, ag, ab = Settings.AccentR, Settings.AccentG, Settings.AccentB
        local lightPanel = r * 0.2126 + g * 0.7152 + b * 0.0722 > 145
        local step = lightPanel and -1 or 1
        colors.Background = color(r, g, b)
        colors.Input = color(r + step * 10, g + step * 10, b + step * 10)
        colors.Border = color(r - step * 7, g - step * 7, b - step * 7)
        colors.Selected = color(r + step * 28, g + step * 28, b + step * 28)
        colors.Hover = color(r + step * 23, g + step * 23, b + step * 23)
        colors.Press = color(r + step * 39, g + step * 39, b + step * 39)
        colors.BorderHover = color(r + step * 57, g + step * 57, b + step * 57)
        colors.BorderPress = color(r + step * 84, g + step * 84, b + step * 84)
        colors.Text = lightPanel and Color3.fromRGB(24, 24, 24) or Color3.fromRGB(224, 224, 224)
        colors.Muted = lightPanel and Color3.fromRGB(75, 75, 75) or Color3.fromRGB(148, 148, 148)
        colors.TextHover = lightPanel and Color3.fromRGB(12, 12, 12) or Color3.fromRGB(242, 242, 242)
        colors.TextPress = lightPanel and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
        colors.Accent = color(ar, ag, ab)
        local hue, saturation, brightness = colors.Accent:ToHSV()
        colors.AccentHover = Color3.fromHSV(hue, saturation * 0.9, math.clamp(brightness * 1.08, 0, 1))
        colors.AccentPress = Color3.fromHSV(hue, saturation, math.clamp(brightness * 0.78, 0, 1))
        for object, properties in pairs(themeBindings) do
            if object.Parent then
                for property, role in pairs(properties) do
                    object[property] = colors[role]
                end
            end
        end
        if previewWidget then previewWidget:Update() end
    end
    local function setFeedbackGoal(object, goals, instant)
        if destroyed or not object.Parent then return end
        local previous = feedbackGoals[object]
        local same = previous ~= nil
        if same then
            for property, value in pairs(goals) do
                if previous[property] ~= value then same = false; break end
            end
            if same then
                for property in pairs(previous) do
                    if goals[property] == nil then same = false; break end
                end
            end
        end
        if same then return end
        stopFeedbackTween(object)
        feedbackGoals[object] = goals
        if instant or not visible then
            for property, value in pairs(goals) do object[property] = value end
            return
        end
        local ok, tween = pcall(TweenService.Create, TweenService, object, feedbackInfo, goals)
        if not ok or not tween then
            for property, value in pairs(goals) do object[property] = value end
            return
        end
        local entry = { Tween = tween }
        feedbackTweens[object] = entry
        entry.Connection = tween.Completed:Connect(function()
            if feedbackTweens[object] == entry then feedbackTweens[object] = nil end
            if entry.Connection then entry.Connection:Disconnect() end
            tween:Destroy()
        end)
        tween:Play()
    end
    local function feedbackColor(state, idle, hover, press)
        return state == "Press" and press or state == "Hover" and hover or idle
    end
    local function refreshFeedbackEntry(entry, instant)
        if destroyed then return end
        local state = "Idle"
        if visible and gui.Enabled and entry.Control.Parent and entry.Available() then
            local current = entry.Control.GuiState
            if current == Enum.GuiState.Press then state = "Press"
            elseif current == Enum.GuiState.Hover then state = "Hover" end
        end
        for _, target in ipairs(entry.Style(state)) do
            setFeedbackGoal(target.Object, target.Goals, instant)
        end
    end
    refreshFeedback = function(instant)
        if destroyed then return end
        for _, entry in ipairs(feedbackEntries) do refreshFeedbackEntry(entry, instant) end
    end
    local function bindFeedback(control, style, available)
        local entry = { Control = control, Style = style, Available = available or canInteractWindow }
        feedbackEntries[#feedbackEntries + 1] = entry
        entry.Connection = Track(control:GetPropertyChangedSignal("GuiState"), function()
            refreshFeedbackEntry(entry, false)
        end)
        refreshFeedbackEntry(entry, true)
        return entry
    end
    bindFeedback(closeButton, function(state)
        return {{ Object = closeButton, Goals = {
            TextColor3 = feedbackColor(state, colors.Muted, colors.TextHover, colors.TextPress),
        }}}
    end)

    local function contains(object, position)
        local origin, size = object.AbsolutePosition, object.AbsoluteSize
        return position.X >= origin.X and position.Y >= origin.Y
            and position.X <= origin.X + size.X and position.Y <= origin.Y + size.Y
    end
    local function positionDropdown(dropdown)
        local area = canvas.AbsoluteSize
        local anchor = dropdown.Button.AbsolutePosition - canvas.AbsolutePosition
        local anchorSize = dropdown.Button.AbsoluteSize
        local width = math.min(math.max(156, anchorSize.X), math.max(1, area.X - 16))
        local height = math.min(dropdown.ContentHeight, 220, math.max(1, area.Y - 16))
        local x = math.clamp(anchor.X, 8, math.max(8, area.X - width - 8))
        local y = anchor.Y + anchorSize.Y + 4
        if y + height > area.Y - 8 then y = anchor.Y - height - 4 end
        y = math.clamp(y, 8, math.max(8, area.Y - height - 8))
        dropdown.Menu.Position = UDim2.fromOffset(x, y)
        dropdown.Menu.Size = UDim2.fromOffset(width, height)
    end
    local function rememberGeometry()
        Settings.UIX, Settings.UIY = panel.Position.X.Offset, panel.Position.Y.Offset
        Settings.UIWidth, Settings.UIHeight = panel.Size.X.Offset, panel.Size.Y.Offset
    end
    local function applyRectangle(x, y, width, height)
        geometryDepth = geometryDepth + 1
        panel.Position = UDim2.fromOffset(x, y)
        panel.Size = UDim2.fromOffset(width, height)
        for name, content in pairs(tabContents) do
            local heightOffset = name == "Assistance" and 130 or 97
            content.Size = UDim2.new(1, -math.min(20, width), 0, math.max(0, height - heightOffset))
        end
        if layoutTabs then layoutTabs() end
        if layoutAssistTabs then layoutAssistTabs() end
        if layoutRows then layoutRows() end
        geometryDepth = geometryDepth - 1
        rememberGeometry()
