        local state = configUI.State
        rebuildConfigOptions(state.Names)
        configsLabel.Text = state.Selected ~= "" and state.Selected or "None"
        for _, option in ipairs(configsDropdown.Options) do
            option.Button.BackgroundTransparency = option.Name == state.Selected and 0 or 1
        end
        configNameBox.TextEditable = configReady()
        autoMark.Visible = state.AutoLoad
        local message = configUI.Notice ~= "" and configUI.Notice or state.Status
        if configUI.Notice == "" and state.AutoLoad and state.Loaded ~= ""
            and not string.find(state.Status, "Auto load:", 1, true) then
            message = (state.Status ~= "" and state.Status .. " | " or "") .. "Auto: " .. state.Loaded
        end
        updateConfigStatus(message)
        if not configReady() and activeDropdown == configsDropdown then closeDropdown() end
    end

    layoutRows = function()
        if layoutDepth > 0 then return end
        layoutDepth = layoutDepth + 1
        local positions = {}
        for name in pairs(tabContents) do positions[name] = 1 end
        for _, row in ipairs(rows) do
            local show = not row.ShowWhen or row.ShowWhen()
            row.Frame.Visible = show
            if show then
                row.Frame.Position = UDim2.fromOffset(1, positions[row.Tab])
                positions[row.Tab] = positions[row.Tab] + row.Height + row.Gap
            end
        end
        for name, content in pairs(tabContents) do
            local height = positions[name] + 1
            content.CanvasSize = UDim2.fromOffset(0, height)
            local scrollY = math.clamp(content.CanvasPosition.Y, 0, math.max(0, height - content.AbsoluteSize.Y))
            if content.CanvasPosition.X ~= 0 or scrollY ~= content.CanvasPosition.Y then
                content.CanvasPosition = Vector2.new(0, scrollY)
            end
        end
        if activeDropdown and not canInteractRow(activeDropdown.Row) then closeDropdown() end
        if dragSlider and not canInteractRow(dragSlider.Row) then endDrag() end
        local focused = Input:GetFocusedTextBox()
        for _, slider in ipairs(sliders) do
            if focused == slider.NumberBox then
                if not canInteractRow(slider.Row) then
                    slider.EditingProperty = nil
                    slider.NumberBox.Text = formatNumber(slider, numericValue(slider))
                    slider.NumberBox:ReleaseFocus()
                elseif slider.EditingProperty and slider.EditingProperty ~= resolveProperty(slider) then
                    slider.NumberBox:ReleaseFocus()
                end
            end
        end
        layoutDepth = layoutDepth - 1
    end
    local function moveSlider(slider, property, position)
        if not dragHeld() or not canInteractRow(slider.Row) then return end
        local fraction = math.clamp((position.X - slider.Button.AbsolutePosition.X)
            / math.max(1, slider.Button.AbsoluteSize.X), 0, 1)
        local value = quantize(slider, slider.Minimum + fraction * (slider.Maximum - slider.Minimum))
        if value ~= Settings[property] then changeSetting(property, value) end
    end
    local function beginDrag(input, kind, slider)
        if not canInteractWindow() or dragInput then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if kind == "slider" and not canInteractRow(slider.Row) then return end
        closeDropdown()
        dragInput, dragKind, dragSlider = input, kind, slider
        dragStart, panelStart = input.Position, panel.Position
        panelDragStarted = false
        if slider then
            dragProperty = resolveProperty(slider)
            moveSlider(slider, dragProperty, input.Position)
        end
    end
    local function beginResize(input, edges)
        if not canInteractWindow() or dragInput then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        closeDropdown()
        releaseInputFocus()
        clampPanel()
        local area = canvas.AbsoluteSize
        if area.X <= 0 or area.Y <= 0 then return end
        local x, y = panel.Position.X.Offset, panel.Position.Y.Offset
        resizeStart = {
            Left = x, Top = y, Right = x + panel.Size.X.Offset,
            Bottom = y + panel.Size.Y.Offset, ViewWidth = area.X, ViewHeight = area.Y,
        }
        resizeEdges, dragInput, dragKind, dragStart = edges, input, "resize", input.Position
    end
    local function moveResize(position)
        local area = canvas.AbsoluteSize
        if not resizeStart or area.X <= 0 or area.Y <= 0 then endDrag(); return end
        if area.X ~= resizeStart.ViewWidth or area.Y ~= resizeStart.ViewHeight then
            endDrag()
            clampPanel()
            return
        end
        local delta = position - dragStart
        local minWidth, minHeight = math.min(MIN_WIDTH, area.X), math.min(MIN_HEIGHT, area.Y)
        local left, right = resizeStart.Left, resizeStart.Right
        local top, bottom = resizeStart.Top, resizeStart.Bottom
        if resizeEdges.West then left = math.clamp(left + delta.X, 0, right - minWidth) end
        if resizeEdges.East then right = math.clamp(right + delta.X, left + minWidth, area.X) end
        if resizeEdges.North then top = math.clamp(top + delta.Y, 0, bottom - minHeight) end
        if resizeEdges.South then bottom = math.clamp(bottom + delta.Y, top + minHeight, area.Y) end
        applyRectangle(left, top, right - left, bottom - top)
    end
    Track(header.InputBegan, function(input) beginDrag(input, "panel") end)
    Track(title.InputBegan, function(input) beginDrag(input, "panel") end)
    for _, region in ipairs(resizeHandles) do
        local edges = region.Edges
        Track(region.Button.InputBegan, function(input) beginResize(input, edges) end)
    end
    for _, slider in ipairs(sliders) do
        local selectedSlider = slider
        Track(selectedSlider.Button.InputBegan, function(input) beginDrag(input, "slider", selectedSlider) end)
    end
    Track(Input.InputChanged, function(input)
        if destroyed or not dragInput then return end
        if not canInteractWindow() then endDrag(); return end
        if not dragHeld() then return end
        local mouseMove = dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        if input ~= dragInput and not mouseMove then return end
        if dragKind == "slider" then moveSlider(dragSlider, dragProperty, input.Position)
        elseif dragKind == "resize" then moveResize(input.Position)
        else
            local delta = input.Position - dragStart
            if not panelDragStarted then
                if delta.X * delta.X + delta.Y * delta.Y < PANEL_DRAG_THRESHOLD * PANEL_DRAG_THRESHOLD then return end
                panelDragStarted = true
            end
            panel.Position = UDim2.fromOffset(panelStart.X.Offset + delta.X, panelStart.Y.Offset + delta.Y)
            clampPanel()
        end
    end)
    Track(Input.InputEnded, function(input)
        if not dragInput then return end
        if input == dragInput or (input.UserInputType == Enum.UserInputType.MouseButton1
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1) then endDrag() end
    end)
    Track(Input.WindowFocusReleased, function() endDrag(); closeDropdown() end)
    Track(Input.InputBegan, function(input)
        if not canInteractWindow() or not activeDropdown then return end
        if input.KeyCode == Enum.KeyCode.Escape then closeDropdown()
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if not contains(activeDropdown.Menu, input.Position) and not contains(activeDropdown.Button, input.Position) then
                closeDropdown()
            end
        end
    end)
    for name, content in pairs(tabContents) do
        local tabName, tabContent = name, content
        Track(tabContent:GetPropertyChangedSignal("CanvasPosition"), function()
            if tabContent.CanvasPosition.X ~= 0 then
                tabContent.CanvasPosition = Vector2.new(0, tabContent.CanvasPosition.Y)
            end
            if activeDropdown and activeDropdown.Row.Container == tabContent then closeDropdown() end

            if activeTab == tabName and dragKind ~= "resize"
                and geometryDepth == 0 and layoutDepth == 0 then endDrag() end
        end)
        Track(tabContent:GetPropertyChangedSignal("AbsoluteSize"), layoutRows)
    end
    Track(canvas:GetPropertyChangedSignal("AbsoluteSize"), function()
        if geometryDepth == 0 then endDrag(); clampPanel() end
    end)
    Track(closeButton.Activated, function() if canInteractWindow() then ctx.OnUnload() end end)
    Track(gui.Destroying, function()
