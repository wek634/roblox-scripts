                    { Object = label, Goals = {TextColor3 = feedbackColor(state, colors.Text, colors.TextHover, colors.TextPress)} },
                }
            end, function() return configInteractive(configsRow) and activeDropdown == configsDropdown and configsMenu.Visible end)
