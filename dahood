    local function configOperation(method, ...)
        if destroyed or configUI.Pending then return false end
        local backend = ctx.Configs
        if type(backend) ~= "table" or type(backend[method]) ~= "function" then
            configUI.Notice = "Config storage unavailable"
            configStatusRevision = configStatusRevision + 1
            if syncConfigUI then syncConfigUI() end
            return false
        end
        releaseInputFocus()
        configUI.Pending, configUI.Notice = true, ""
        if syncConfigUI then syncConfigUI() end
        local ok, success, message = pcall(backend[method], backend, ...)
        configUI.Pending = false
        if not ok then configUI.Notice = "Config operation failed"
        elseif success ~= true then configUI.Notice = tostring(message or "Config operation failed") end
        if (method ~= "Refresh" and method ~= "Select") or not ok or success ~= true then
            configStatusRevision = configStatusRevision + 1
        end
        if not destroyed and syncConfigUI then syncConfigUI() end
        return not destroyed and ok and success == true
    end

