        end
        if type(key) == "string" and Settings[key] == true and normalized == false then
            local prefix
            if string.sub(key, 1, 9) == "AimSelect" then prefix = "Aim"
            elseif string.sub(key, 1, 13) == "TriggerSelect" then prefix = "Trigger"
            elseif string.sub(key, 1, 12) == "HitboxSelect" then prefix = "Hitbox" end
            if prefix then
                local checked = 0
                for _, option in ipairs(AIM_PART_OPTIONS) do
                    if Settings[scopedPartKey(prefix, option.Name)] == true then checked = checked + 1 end
                end
                if checked <= 1 then return false, "Choose at least one body part" end
