local function toggleEnabled(value)
    ENV.AUTO_GK_ENABLED = value == true
    S.nextPlanAt = 0

    if ENV.AUTO_GK_ENABLED then
        S.runtimeFailures = 0
        S.runtimeRetryAt = 0
        S.runtimeError = nil
    end

    if not ENV.AUTO_GK_ENABLED then
        releaseOwnedState(true)
        status("OFF", "Manual controls untouched")
    end
end

